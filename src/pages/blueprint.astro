      </details>
    </div>
  </section>
</Layout>

<script>
  import { wireGroup } from '../scripts/group';
  import { revealInRow } from '../scripts/sidescroll';

  // The design switch changes every panel on the page, and the drawings.
  const figures = Array.from(document.querySelectorAll<HTMLElement>('[data-bpfig]'));
  wireGroup({
    key: 'scen',
    buttons: 'button[data-scen]',
    panels: 'div[data-scen]',
    onChange: (id) => figures.forEach((f) => (f.dataset.design = id)),
  });
  document.querySelectorAll<HTMLElement>('.locwrap').forEach((root) => {
    wireGroup({ key: 'locus', buttons: 'button[data-locus]', panels: 'div[data-locus]', root });
  });

  // The bar of section links stays at the top. It is one row on a wide screen and two on a phone, so jumps to a section
  // are kept clear of it by its real height (--bar, used by every scroll-margin on this page).
  const subnav = document.querySelector<HTMLElement>('.subnav');
  if (subnav) {
    const setBar = () => document.documentElement.style.setProperty('--bar', `${Math.round(subnav.getBoundingClientRect().height)}px`);
    setBar();
    new ResizeObserver(setBar).observe(subnav);
  }

  // The section links show where you are on this long page. On a phone the row scrolls to keep that link in view.
  const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('.subnav__links a[href^="#"]')];
  const sections = sectionLinks.map((a) => document.getElementById(a.hash.slice(1))).filter((s): s is HTMLElement => !!s);
  const linkRow = document.querySelector<HTMLElement>('.subnav__links');
  let marked = '';
  function markSection() {
    const line = (subnav?.getBoundingClientRect().height ?? 56) + 48;
    let here = '';
    for (const s of sections) if (s.getBoundingClientRect().top <= line) here = s.id;
    if (here === marked) return;
    marked = here;
    sectionLinks.forEach((a) => {
      const on = a.hash === `#${here}`;
      if (on) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
      if (on && linkRow) revealInRow(linkRow, a);
    });
  }
  let queued = false;
  window.addEventListener(
    'scroll',
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        markSection();
      });
    },
    { passive: true },
  );
  markSection();

  // Numbered parts open their section of the specification.
  const spec = document.getElementById('spec') as HTMLDetailsElement;
  function openTo(id: string) {
    spec.open = true;
    const el = document.getElementById(id);
    if (!el) return;
    el.scrollIntoView({ block: 'start' });
    el.classList.add('flash');
    window.setTimeout(() => el.classList.remove('flash'), 1600);
  }
  document.querySelectorAll<HTMLElement>('[data-spec]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const id = el.dataset.spec ?? '';
      history.replaceState(null, '', `#${id}`);
      openTo(id);
    });
  });
  function fromHash() {
    const id = location.hash.slice(1);
    if (id && document.getElementById(id)?.closest('#spec')) openTo(id);
    else if (id === 'spec') spec.open = true;
  }
  window.addEventListener('hashchange', fromHash);
  fromHash();

  // Print or save as PDF: open the paper first.
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  window.addEventListener('beforeprint', () => {
    spec.open = true;
  });
</script>

