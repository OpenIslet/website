---
import Layout from '../layouts/Layout.astro';
import BlueprintFigure from '../components/BlueprintFigure.astro';
import VersionsPlan from '../components/VersionsPlan.astro';
import ProposalArt from '../components/designs/ProposalArt.astro';
import ChangelogArt from '../components/ChangelogArt.astro';
import Odds from '../components/Odds.astro';
import { scenarios, gateColumns, niche, assets, reproduce } from '../data/blueprint';
import { pubmed, release, longDate, showScenarioIndices, startHref } from '../data/site';
import { indices, scoresCaption } from '../data/scenarios';
import { testShort } from '../data/gates';
import { fillTokens } from '../data/specTokens';
import { draft as openDraft } from '../data/versions';
import changelog from '../data/changelog.json';
import ledger from '../data/contributions.json';
import references from '../data/references.json';
import sizes from '../data/downloads.json';
import * as spec from '../content/blueprint-spec.md';

// ---- the concise specification: Markdown text, with numbers and figures filled in ----
const n = (v: number) => v.toLocaleString('en-US');
const c = release.counts;
let html = await spec.compiledContent();
html = fillTokens(html);
html = html
  .replace(/<p>(<a id="[^"]+"><\/a>)<\/p>/g, '$1')
  .replace(/<(\/?)h3/g, '<$1h4')
  .replace(/<(\/?)h2/g, '<$1h3')
  .replace(/<table>/g, '<div class="tablewrap"><table>')
  .replace(/<\/table>/g, '</table></div>');
const parts = html.split(/<!--figure:(\w+)-->/);

const toc = spec.getHeadings().filter((h) => h.depth === 2);
const cited = [...new Set([...spec.rawContent().matchAll(/#ref-(\d{5,9})/g)].map((m) => m[1]))];
type Ref = { pmid: string; title?: string; authors?: string[]; journal?: string; year?: number; doi?: string };
const refList = cited
  .map((id) => (references as Record<string, Ref>)[id])
  .filter(Boolean)
  .sort((x, y) => (x.authors?.[0] ?? '').localeCompare(y.authors?.[0] ?? ''));
const authorsOf = (r: Ref) => {
  const list = r.authors ?? [];
  return list.length > 3 ? `${list.slice(0, 3).join(', ')}, et al.` : list.join(', ');
};
const refLabel = (r: Ref) => {
  const first = (r.authors?.[0] ?? '').split(' ')[0];
  return first ? `${first}${(r.authors?.length ?? 0) > 1 ? ' et al.' : ''} ${r.year ?? ''}`.trim() : `PMID ${r.pmid}`;
};

// ---- changelog ----
const kindLabel: Record<string, string> = { added: 'Added', changed: 'Changed', fixed: 'Fixed', removed: 'Removed' };

// The colour key under each gene edit lists only the colours that edit uses.
function keyFor(elems: { kind: string }[]) {
  const has = (k: string) => elems.some((e) => e.kind === k);
  const items: { sw: string; label: string }[] = [];
  if (has('cds')) items.push({ sw: 'cds', label: 'Protein-coding' });
  if (has('reg')) items.push({ sw: 'reg', label: 'Control region' });
  if (has('link')) items.push({ sw: 'link', label: 'Linker' });
  if (has('ins') || has('ko')) {
    items.push({ sw: 'ins', label: has('ins') && has('ko') ? 'Insulator or switched off' : has('ins') ? 'Insulator' : 'Switched off' });
  }
  if (has('keep')) items.push({ sw: 'keep', label: 'Kept as it is' });
  if (has('edit')) items.push({ sw: 'edit', label: 'Base edit' });
  return items;
}
const handleOf = (id?: string) => (ledger as { id: string; contributor: { handle: string } }[]).find((x) => x.id === id)?.contributor.handle;
const recent = changelog.slice(0, 3);
const older = changelog.slice(3);

// ---- downloads ----
const sizeOf = (path: string): string => {
  const bytes = (sizes as Record<string, number>)[path];
  if (!bytes) return '';
  return bytes >= 1_000_000 ? `${(bytes / 1_000_000).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1000))} KB`;
};
const groups = [
  { id: 'read', title: 'Read the blueprint', text: 'Text you can read on any device.' },
  { id: 'check', title: 'Check the evidence', text: 'The data behind the claims, if you want to check them yourself.' },
  { id: 'trust', title: 'Check nothing has changed', text: 'For people who build on the data or want to verify a download.' },
];

const markName = { p: 'Main job', s: 'Helps', x: 'Trade-off', n: 'Not involved' } as const;
---

<Layout
  title="Blueprint"
  description="The Islet-1 blueprint: three designs for a personalised type 1 diabetes cure, as a clickable drawing, a concise specification, a changelog and the data."
  current="blueprint"
  share="blueprint"
>
  <section class="intro">
    <div class="container">
      <p class="eyebrow">Blueprint</p>
      <h1 class="h1 intro__h">The <span class="nobr">Islet-1</span> blueprint</h1>
      <p class="lead intro__lead">
        A plan for a personalised cure for type 1 diabetes that aims to need no anti-rejection drugs.
      </p>

      <div class="explain">
        <div class="explain__item">
          <p class="explain__k">What it is</p>
          <h2>A public plan for cells designed to be left alone by the immune system</h2>
          <p>A detailed design for gene-edited, lab-grown islet cells, with an oxygen supply and a safety switch. It is written so scientists can check each claim against its source, and so anyone with an AI assistant can help improve it.</p>
        </div>
        <div class="explain__item">
          <p class="explain__k">Why three designs</p>
          <h2>Nobody knows yet which approach works best</h2>
          <p>Design A is the simplest idea and the lead design. Design B is a more tailored idea that carries more risk. Design X is the challenger: Design A with one more edit. The blueprint carries all three, so lab tests can decide instead of a guess.</p>
        </div>
        <div class="explain__item">
          <p class="explain__k">How to read this page</p>
          <h2>Look, select, then scroll</h2>
          <p>Look at the drawing. Select any numbered part to read its section of the specification. Scroll for the three designs side by side, the changelog, and the data.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="subnav">
    <div class="container subnav__inner">
      <ul class="subnav__links" data-sidescroll>
        <li><a href="#drawing">Drawing</a></li>
        <li><a href="#spec">Specification</a></li>
        <li><a href="#designs">Three designs</a></li>
        <li><a href="#odds">Odds</a></li>
        <li><a href="#edits">Edit by edit</a></li>
        <li><a href="#changelog">Changelog</a></li>
        <li><a href="#data">Get the data</a></li>
      </ul>
      <div class="subnav__switch" role="group" aria-label="Choose a design">
        <span>Showing</span>
        <button type="button" data-scen="A" aria-pressed="true">Design A</button>
        <button type="button" data-scen="B" aria-pressed="false">Design B</button>
        <button type="button" data-scen="X" aria-pressed="false">Design X</button>
      </div>
    </div>
  </div>

  <!-- Drawing -->
  <section class="drawing" id="drawing">
    <div class="container">
      <h2 class="h2">The blueprint, as a drawing</h2>
      <p class="lead drawing__lead">Select a numbered part to open its section of the specification.</p>
      <div class="drawing__fig"><BlueprintFigure design="A" /></div>
    </div>
  </section>

  <!-- Specification -->
  <section class="specsec">
    <div class="container">
      <details class="specwrap" id="spec">
        <summary class="specwrap__sum">
          <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v4h4M9 12h6M9 16h6"></path></svg>
          <span class="specwrap__t">
            <strong>Blueprint specification</strong>
            <span>A concise paper, about 10 minutes to read · {release.version} · with references, figures and tables</span>
          </span>
          <span class="specwrap__open"><span class="when-closed">Open</span><span class="when-open">Close</span></span>
        </summary>

        <div class="specdoc">
          <nav class="toc" aria-label="Specification contents">
            <p class="toc__k">Contents</p>
            <ol>
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
              <li><a href="#references">References</a></li>
            </ol>
            <div class="toc__actions">
              <button type="button" class="btn btn--quiet" data-print>Print or save as PDF</button>
              <a class="textlink" href="/downloads/ISLET-1-BLUEPRINT.md" download>Download the full, long version →</a>
            </div>
          </nav>

          <article class="paper">
            <header class="paper__head">
              <p class="paper__k">Concise specification · {release.version} · {longDate(release.date)}</p>
              <h2 class="paper__title">{spec.frontmatter.title}</h2>
              <p class="paper__meta">
                Status: design stage, not yet tested in the lab. Licence: CC BY 4.0. Cite as: OpenIslet (2026), Islet-1 blueprint {release.version}.
                <a href="#changelog">See what changed</a>.
              </p>
            </header>

            {
              parts.map((p, i) => {
                if (i % 2 === 0) return <Fragment set:html={p} />;
                if (p === 'blueprint')
                  return (
                    <figure class="paperfig">
                      <BlueprintFigure interactive={false} design="A" idp="bpp" />
                      <figcaption><strong>Figure 1.</strong> Islet-1 as an engineering drawing. The cell with its gene edits is on the left, and a cross-section of the graft is on the right. Use the Design A, Design B and Design X buttons at the top of the page to switch.</figcaption>
                    </figure>
                  );
                if (p === 'scores')
                  return (
                    <div class="papertable">
                      {showScenarioIndices ? (
                        <div class="tablewrap" data-label="Scores for each design on each test">
                          <table>
                            <thead>
                              <tr><th scope="col">Design</th><th scope="col">Rank of {n(c.designs)} (overall score)</th><th scope="col">Gene edits</th><th scope="col">Model score (child profile)</th><th scope="col">Weakest test</th></tr>
                            </thead>
                            <tbody>
                              {indices.map((r) => (
                                <tr>
                                  <th scope="row">
                                    {r.name}
                                    {r.reference && <span class="refnote">Another group’s design, scored as a check on the model</span>}
                                  </th>
                                  <td>{r.rank}</td>
                                  <td>{r.sub.replace('reference · ', '')}</td>
                                  <td class="mono">{r.value.toFixed(4)}</td>
                                  <td>{testShort[r.weakestTest]}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      ) : (
                        <p class="footnote">Model scores are not shown in this version.</p>
                      )}
                      <p class="caption"><strong>Table 3.</strong> {scoresCaption}</p>
                    </div>
                  );
                return null;
              })
            }

            <section id="references" class="refs">
              <h3>References</h3>
              <ol>
                {
                  refList.map((r) => (
                    <li id={`ref-${r.pmid}`}>
                      <span class="refs__label">{refLabel(r)}</span>
                      {authorsOf(r)}{r.year ? ` (${r.year}). ` : ' '}{r.title} <em>{r.journal}</em>.
                      <a href={pubmed(r.pmid)} target="_blank" rel="noopener">PMID {r.pmid}</a>
                      {r.doi && <> · <a href={`https://doi.org/${r.doi}`} target="_blank" rel="noopener">doi:{r.doi}</a></>}
                    </li>
                  ))
                }
              </ol>
            </section>
          </article>
        </div>
      </details>
    </div>
  </section>

  <!-- Two designs side by side -->
  <section class="designs" id="designs">
    <div class="container">
      <p class="eyebrow">Compare</p>
      <h2 class="h2">The three designs, side by side</h2>
      <p class="lead designs__lead">Each row is one edit. Each column is one of the five tests, with test 2 split in two. The dots show which tests each edit is meant to help: its intended role, not a measured result.</p>

      {
        scenarios.map((s) => (
          <div data-scen={s.id} hidden={s.id !== 'A'}>
            <h3 class="designs__h">{s.headline}</h3>

            {
              s.twoIdeas && (
                <div class="twoideas">
                  <p class="twoideas__h">{s.twoIdeas.title}</p>
                  <div class="grid" style="--min: 18.75rem; --gap: 1rem">
                    <div class="fact">
                      <p class="kicker">{s.twoIdeas.scored.title}</p>
                      <p class="pretty">{s.twoIdeas.scored.text}</p>
                    </div>
                    <div class="fact">
                      <p class="kicker">{s.twoIdeas.proposal.title}</p>
                      <p class="pretty">{s.twoIdeas.proposal.text}</p>
                    </div>
                  </div>
                </div>
              )
            }

            <div class="card matrix">
              <div class="matrix__scroll" data-label={`${s.name}: which edit helps which test`}>
                <table>
                  <thead>
                    <tr>
                      <th scope="col">Edit</th>
                      {gateColumns.map((g) => (<th scope="col"><span class="colcode">Test {g.code}</span>{g.name}</th>))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.rows.map((r) => (
                      <tr>
                        <th scope="row"><strong>{r.name}</strong><span>{r.sub}</span></th>
                        {r.marks.split('').map((m) => (
                          <td>
                            <span class={`dot dot--${m}`}></span>
                            <span class="sr-only">{markName[m as keyof typeof markName]}</span>
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="legend">
                <span><i class="dot dot--p"></i> Main job</span>
                <span><i class="dot dot--s"></i> Helps</span>
                <span><i class="dot dot--x"></i> Trade-off</span>
              </div>
            </div>

            <div class="grid" style="--min: 18.75rem; --gap: 1.5rem; margin-top: 1.75rem">
              <div class="fact">
                <p class="kicker">Best for</p>
                <p class="pretty">{s.aim}</p>
              </div>
              <div class="fact fact--warn">
                <p class="kicker kicker--warn">Main risk</p>
                <p class="pretty">{s.risk}</p>
                <a class="textlink" href="/idea-graveyard">See the Idea Graveyard →</a>
              </div>
            </div>

            {
              s.proposals && (
                <div class="proposals">
                  <h4 class="proposals__h">Still on paper: proposed upgrades</h4>
                  <p class="proposals__lead pretty">None of these is built, measured or counted in the model’s scores. Each would be tested in the lab before it is used.</p>
                  <div class="proposals__grid">
                    {s.proposals.map((p) => (
                      <div class="proposal">
                        <div class="proposal__art"><ProposalArt id={p.art} /></div>
                        <p class="kicker">Proposal</p>
                        <h5 class="proposals__t">{p.title}</h5>
                        <p class="pretty">{p.text}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )
            }
          </div>
        ))
      }
    </div>
  </section>

  <!-- Realistic chance of working -->
  <Odds />

  <!-- Edit by edit -->
  <section class="edits" id="edits">
    <div class="container">
      <p class="eyebrow">Detail</p>
      <h2 class="h2">The gene edits, one by one</h2>
      <p class="lead designs__lead">Pick an edit to see how it is built and the papers behind it.</p>

      {
        scenarios.map((s) => (
          <div data-scen={s.id} class="locwrap" hidden={s.id !== 'A'}>
            <div class="row" role="group" aria-label={`Choose an edit in ${s.name}`} style="--gap: 0.5rem">
              {s.loci.map((l, i) => (
                <button type="button" class="choice mono" data-locus={l.id} aria-pressed={String(i === 0)}>{l.label}</button>
              ))}
            </div>

            {s.loci.map((l, i) => (
              <div class="card locus" data-locus={l.id} hidden={i !== 0}>
                <div class="locus__head">
                  <h3>{l.title}</h3>
                  <span class="locus__gates">{l.gates}</span>
                </div>
                <p class="locus__action">{l.action}</p>

                <div class="strip__scroll" data-label={`${l.title}: how the DNA edit is built`}>
                  <div class="strip">
                    {l.elems.map((e) => (
                      <div class={`elem elem--${e.kind}`} style={`flex:${e.grow} 1 0`}>
                        <span class="elem__l">{e.label}</span>
                        {e.sub && <span class="elem__s">{e.sub}</span>}
                      </div>
                    ))}
                  </div>
                </div>
                <div class="key">
                  {keyFor(l.elems).map((k) => (<span><i class={`sw sw--${k.sw}`}></i> {k.label}</span>))}
                </div>

                <div class="grid locus__cols" style="--min: 20rem; --gap: 1.75rem 3rem">
                  <div>
                    <p class="label">What it does</p>
                    <ul class="notes">
                      {l.notes.map((note) => (<li class="pretty">{note}</li>))}
                    </ul>
                  </div>
                  {l.pmids.length > 0 && (
                    <div>
                      <p class="label">Papers</p>
                      <div class="row" style="--gap: 0.5rem; margin-top: 0.625rem">
                        {l.pmids.map((p) => (
                          <a class="pmid" href={pubmed(p)} target="_blank" rel="noopener">PMID {p}</a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        ))
      }

      <div class="niche">
        <h3>The environment around the cells</h3>
        <dl class="kv">
          {niche.map((row) => (<div><dt>{row.k}</dt><dd>{row.v}</dd></div>))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Changelog -->
  <section class="changelog" id="changelog">
    <div class="container">
      <p class="eyebrow">Changelog</p>
      <h2 class="h2">What has changed</h2>
      <p class="lead designs__lead">Every change to the blueprint after the open draft opens is listed here, newest first, with what changed and who is credited.</p>

      <VersionsPlan />

      <div class="clwrap">
        <div>
          {changelog.length === 0 && (
            <div class="cl__empty">
              <div class="cl__emptyart"><ChangelogArt /></div>
              <h3>Nothing has changed yet</h3>
              <p class="pretty">The changelog starts when the open draft opens on {longDate(openDraft.opens)}. From then on, every change is listed here, newest first, with what changed and who is credited.</p>
            </div>
          )}
          {
            changelog.length > 0 && (
          <ol class="cl">
            {
              recent.map((e) => (
                <li class="cl__item">
                  <div class="cl__head">
                    <span class="chip chip--ink">{e.version}</span>
                    <time datetime={e.date}>{longDate(e.date)}</time>
                  </div>
                  <h3>{e.title}</h3>
                  <p>{e.summary}</p>
                  <ul class="cl__changes">
                    {e.changes.map((ch) => (<li><span class={`kind kind--${ch.kind}`}>{kindLabel[ch.kind]}</span><span>{ch.text}</span></li>))}
                  </ul>
                  {handleOf(e.contribution) && (
                    <p class="cl__credit">Credit: <a href={`/contributions#${(e.contribution ?? '').toLowerCase()}`}>@{handleOf(e.contribution)}</a> · contribution <span class="mono">{e.contribution}</span></p>
                  )}
                </li>
              ))
            }
          </ol>
            )
          }
          {
            older.length > 0 && (
              <details class="cl__older">
                <summary>Show {older.length} older {older.length === 1 ? 'version' : 'versions'}</summary>
                <ol class="cl">
                  {older.map((e) => (
                    <li class="cl__item">
                      <div class="cl__head">
                        <span class="chip chip--ink">{e.version}</span>
                        <time datetime={e.date}>{longDate(e.date)}</time>
                      </div>
                      <h3>{e.title}</h3>
                      <p>{e.summary}</p>
                      <ul class="cl__changes">
                        {e.changes.map((ch) => (<li><span class={`kind kind--${ch.kind}`}>{kindLabel[ch.kind]}</span><span>{ch.text}</span></li>))}
                      </ul>
                    </li>
                  ))}
                </ol>
              </details>
            )
          }
        </div>

        <aside class="how">
          <h3>How the blueprint gets updated</h3>
          <ol>
            <li><span>1</span><div><strong>An IIP is accepted.</strong> It has been through the open review on GitHub.</div></li>
            <li><span>2</span><div><strong>The blueprint changes.</strong> The files in the public repository are edited and re-checked.</div></li>
            <li><span>3</span><div><strong>A version and a line are added.</strong> The version number goes up and the changelog gains an entry.</div></li>
            <li><span>4</span><div><strong>This site updates.</strong> Every number is read from the release files, and the contributor is credited.</div></li>
          </ol>
          <details class="how__dev">
            <summary>For maintainers: the commands</summary>
            <pre data-scroll-region data-label="Commands to update the blueprint">npm run sync-data
npm run changelog -- \
  --version v0.8.1 \
  --title "A short title" \
  --summary "One plain sentence." \
  --fixed "What changed." \
  --contribution IIP-0002
npm run build</pre>
            <p class="footnote">Edit <span class="mono">src/content/blueprint-spec.md</span> to change the specification. See <span class="mono">docs/UPDATING.md</span>.</p>
          </details>
        </aside>
      </div>
    </div>
  </section>

  <!-- Downloads -->
  <section class="data" id="data">
    <div class="container">
      <p class="eyebrow">Get the data</p>
      <h2 class="h2">Download the data behind the blueprint</h2>
      <div class="insight data__note">
        <span class="insight__k">You don’t need to download anything to help.</span>
        <span>Your connected AI can already read all of this. Download a file only if you want to read offline, check a claim against its source, or run your own analysis.</span>
      </div>

      {
        groups.map((g) => (
          <div class="dlgroup">
            <h3>{g.title}</h3>
            <p class="dlgroup__t">{g.text}</p>
            <ul class="assets">
              {assets.filter((x) => x.group === g.id).map((x) => (
                <li class="assets__row">
                  <div class="assets__name">
                    <strong>{x.title}</strong>
                    <span class="assets__what">{x.what}</span>
                    <span class="assets__meta">{x.for} · {x.format}{sizeOf(x.path) ? ` · ${sizeOf(x.path)}` : ''} · {x.license}</span>
                  </div>
                  <a class="btn btn--primary" href={`/downloads/${x.path}`} download>Download</a>
                </li>
              ))}
              {g.id === 'check' && (
                <li class="assets__row">
                  <div class="assets__name">
                    <strong>Context–Evidence Graph: method paper, guide and verifier</strong>
                    <span class="assets__what">How a Context–Evidence Graph keeps experimental groups, units and settings attached to every finding, with a plain-English guide and Python verifier for building one in any field.</span>
                    <span class="assets__meta">Scientists, developers and AI users · Guide, PDF and Python · CC-BY-4.0 / Apache-2.0</span>
                  </div>
                  <div class="assets__btns">
                    <a class="btn btn--quiet" href="/ceg">Read the guide</a>
                    <a class="btn btn--primary" href="/ceg/context-evidence-graph.pdf" download>Download PDF</a>
                  </div>
                </li>
              )}
            </ul>
          </div>
        ))
      }

      <div class="grid dlnotes" style="--min: 22rem; --gap: 1.5rem">
        <div class="fact">
          <h3>Free to build on</h3>
          <p>Take the blueprint and use it, adapt it or test it in any way you like, in a lab or on the way to patients. We only ask that you credit the OpenIslet community, for example: “Based on the OpenIslet blueprint (openislet.org), made by the OpenIslet community.”</p>
        </div>
        <div class="fact">
          <h3>How to check a file hasn’t changed</h3>
