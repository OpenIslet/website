---
import Layout from '../layouts/Layout.astro';
import CellField from '../components/CellField.astro';
import Decides from '../components/credit/Decides.astro';
import Named from '../components/credit/Named.astro';
import Grows from '../components/credit/Grows.astro';
import { contributors, outcomes, outcomeKinds, quietOutcomes, showExamples, standingOf, standingsShown, type Standing } from '../data/contributions';
import { issuesUrl, longDate, social, startHref } from '../data/site';
import { draft, planned } from '../data/versions';

const kindLabel = { person: 'Person', lab: 'AI lab' };
const shortDate = (iso: string | null) =>
  iso ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`)) : '—';
const standingName: Record<Standing['key'], string> = {
  ...(Object.fromEntries(outcomeKinds.map((k) => [k, outcomes[k].label])) as Record<Standing['key'], string>),
  founding: 'Founding blueprint',
  waiting: 'Waiting for review',
  'needs-work': 'Needs work',
  withdrawn: 'Withdrawn',
};
const credited = outcomeKinds.filter((k) => outcomes[k].credited);
// The closed row and the filter name what an IIP added. "Not taken up" and "Already covered" stay on the IIP itself, inside the opened row.
const quiet = new Set<Standing['key']>(quietOutcomes);
const shownWithReason = outcomeKinds.filter((k) => !outcomes[k].credited);
const versionName = (id: string) => id.replace(/^islet-/, 'Islet-');
---

<Layout
  title="Contributions"
  description="Who has helped improve the OpenIslet blueprint, what each of their IIPs changed, and how credit works."
  current="contributions"
  share="contributions"
>
  <header class="top on-dark">
    <div class="top__bg" aria-hidden="true"><CellField seed={21} count={46} /></div>
    <div class="container top__inner">
      <p class="top__eyebrow">Contributions</p>
      <h1>Who has helped, and what they did</h1>
      <p class="top__lead">Everything that has improved the blueprint, with the people and AI models behind it. Each contribution is credited to the version it lands in: the open draft (from {longDate(draft.opens)}), then Islet-1.0 when it is locked on {longDate(planned[0].lock)}.</p>

      <div class="invite">
        <article class="invite__card">
          <p class="invite__k">Anyone can contribute</p>
          <h2>You don’t need a lab or a degree</h2>
          <p>
            Paste the OpenIslet starter pack into any AI chat (or connect it over MCP), and ask it to stress-test the blueprint or to find a way to improve it. Then send in what it finds, as an Islet Improvement Proposal (IIP).
            Every IIP is checked in the open, and if it improves the plan, you are credited by name.
          </p>
          <a class="btn btn--light btn--lg" href={`${startHref}#step-1`}>Start here</a>
        </article>
        <article class="invite__card invite__card--lab">
          <p class="invite__k">AI labs are especially welcome</p>
          <h2>Point your best models at a problem that matters</h2>
          <p>
            A lot of effort goes into AI benchmarks. Far less goes into asking whether AI can solve a real problem that matters.
            A cure for type 1 diabetes is one.
          </p>
          <p>
            If your lab has models more capable than anything public, point them at the blueprint, privately and on your own computers,
            and share only what they find. We never see your model, prompts or keys, and you choose how the model is named, even
            “unreleased model”. Every result is public, checked and credited to you.
          </p>
          <a class="btn btn--outline-light btn--lg" href={`${startHref}?path=lab#step-1`}>The AI lab guide</a>
        </article>
      </div>
    </div>
  </header>

  <section class="boardsec" id="board">
    <div class="container">
      <p class="eyebrow">The board</p>
      <h2 class="h2 boardsec__h">Who has done what</h2>
      <p class="lead boardsec__lead">
        Open a row to see what each IIP changed, or read <a href="#credit">how credit works</a>.
      </p>

      {
        showExamples && (
          <p class="sample"><strong>Example rows.</strong> Rows marked Example show how the board will look once people start contributing. They are not real contributions.</p>
        )
      }

      <form class="filters" role="search">
        <label class="filters__search">
          <span>Search</span>
          <input id="q" type="search" placeholder="A name or a title" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="search" />
        </label>
        <label>
          <span>Who</span>
          <select id="kind">
            <option value="all">Everyone</option>
            <option value="person">People</option>
            <option value="lab">AI labs</option>
          </select>
        </label>
        <label>
          <span>Outcome</span>
          <select id="outcome">
            <option value="all">All</option>
            {standingsShown.filter((key) => !quiet.has(key)).map((key) => <option value={key}>{standingName[key]}</option>)}
          </select>
        </label>
        <label>
          <span>Sort by</span>
          <select id="sort">
            <option value="recent">Most recent</option>
            <option value="name">Name, A to Z</option>
          </select>
        </label>
      </form>
      <p class="count" id="count" aria-live="polite"></p>

      <ol class="board" id="rows">
        {
          contributors.map((c) => (
            <li
              class={`crow${c.example ? ' crow--example' : ''}`}
              data-name={c.handle}
              data-kind={c.kind}
              data-last={c.last ?? ''}
              data-outcomes={c.did.map((d) => d.key).join(' ')}
              data-search={`${c.handle} ${c.stated.name ?? ''} ${c.contributions.map((x) => x.title).join(' ')}`.toLowerCase()}
            >
              <details>
                <summary class="crow__sum">
                  <span class="crow__who">
                    <strong>@{c.handle}</strong>
                    {c.stated.name && <span class="crow__name">{c.stated.name}</span>}
                    <span class="crow__tags">
                      <span class="chip chip--quiet">{kindLabel[c.kind]}</span>
                      {c.founding && <span class="chip chip--ink">Founder</span>}
                      {c.example && <span class="chip chip--warn">Example</span>}
                      {c.verified.github && <span class="chip chip--pass">GitHub ✓</span>}
                      {c.stated.orcid &&
                        (c.verified.orcid ? (
                          <span class="chip chip--pass">ORCID {c.stated.orcid} ✓</span>
                        ) : (
                          <span class="chip chip--quiet">ORCID {c.stated.orcid} · stated</span>
                        ))}
                      {c.stated.x && <span class="chip chip--quiet">@{c.stated.x} on X · stated</span>}
                    </span>
                  </span>
                  <span class="crow__did">
                    {c.did.filter((d) => !quiet.has(d.key)).map((d) => (
                      <span>
                        {d.label}
                        {d.n > 1 && <b> × {d.n}</b>}
                      </span>
                    ))}
                  </span>
                  <span class="crow__n"><b>{c.contributions.length}</b> {c.contributions.length === 1 ? 'contribution' : 'contributions'}</span>
                  <span class="crow__date">{shortDate(c.last)}</span>
                  <svg class="crow__chev" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </summary>

                <div class="crow__body">
                  {c.stated.orcid && c.verified.orcid && (
                    <p class="crow__stated">
                      Verified through ORCID: <a href={`https://orcid.org/${c.stated.orcid}`} rel="noopener">ORCID {c.stated.orcid}</a>
                    </p>
                  )}
                  {
                    ((c.stated.orcid && !c.verified.orcid) || c.stated.x) && (
                      <p class="crow__stated">
                        Stated by the contributor, not verified:
                        {c.stated.orcid && !c.verified.orcid && <> <a href={`https://orcid.org/${c.stated.orcid}`} rel="noopener">ORCID {c.stated.orcid}</a></>}
                        {c.stated.orcid && !c.verified.orcid && c.stated.x && ' ·'}
                        {c.stated.x && <> <a href={`https://x.com/${c.stated.x}`} rel="noopener">@{c.stated.x} on X</a></>}
                      </p>
                    )
                  }
                  <ul class="clist">
                    {
                      c.contributions.map((x) => {
                        const s = standingOf(x);
                        const o = x.outcome;
                        return (
                          <li class="citem" id={x.id.toLowerCase()} data-outcome={s.key}>
                            <div class="citem__top">
                              <h3>{x.title}</h3>
                              <span class={s.chip}>{s.label}</span>
                            </div>
                            <p class="citem__meta">
                              <span class="chip chip--quiet">{x.type}</span>
                              {o?.key_change && x.landed_in && <span class="chip chip--ink">Key change in {versionName(x.landed_in)}</span>}
                              <span>{shortDate(x.date)}</span>
                              {x.version && <span>Blueprint {x.version}</span>}
                              {x.landed_in && <span>Named in {versionName(x.landed_in)}</span>}
                              {/* A real record's number is its issue in the public queue (IIP-0042 is issue 42), so it links there. */}
                              {x.example ? (
                                <span class="mono">{x.id}</span>
                              ) : (
                                <a class="mono" href={`${issuesUrl}/${Number(x.id.slice(4))}`} rel="noopener">
                                  {x.id} on GitHub
                                </a>
                              )}
                            </p>
                            <p class="citem__summary">{x.summary}</p>
                            {o && (
                              <p class="citem__outcome">
                                <strong>{outcomes[o.kind].why}:</strong> {o.note}
                                {o.with?.length ? ` Credited together with ${o.with.join(', ')}.` : ''}
                                {/* A real record's number is its issue in the public queue (IIP-0042 is issue 42); an example's is not. */}
                                {o.same_as &&
                                  (/^IIP-\d+$/.test(o.same_as) ? (
                                    <>
                                      {' '}First in <a href={`${issuesUrl}/${Number(o.same_as.slice(4))}`}>{o.same_as}</a>.
                                    </>
                                  ) : (
                                    ` First in ${o.same_as}.`
                                  ))}
                                {o.where && (
                                  <>
                                    {' '}
                                    <a class="textlink" href={o.where}>
                                      See it →
                                    </a>
                                  </>
                                )}
                              </p>
                            )}
                            {/* With more than one IIP, each shows its own models, so one IIP's tools are never read as another's. */}
                            {c.contributions.length > 1 && x.models.length > 0 && (
                              <p class="crow__models">
                                <span>AI models used, as reported by the contributor:</span>
                                {x.models.map((m) => <span class="mono-chip">{m}</span>)}
                              </p>
                            )}
                            {x.follow_ups?.length ? (
                              <div class="citem__later">
                                <strong>Since then:</strong>
                                <ul>
                                  {x.follow_ups.map((f) => (
                                    <li>
                                      {f.date && <span class="citem__when">{shortDate(f.date)}</span>}
                                      {f.note}
                                    </li>
                                  ))}
                                </ul>
                              </div>
                            ) : null}
                          </li>
                        );
                      })
                    }
                  </ul>
                  {c.contributions.length === 1 && (
                    <p class="crow__models">
                      <span>AI models used, as reported by the contributor:</span>
                      {c.models.map((m) => <span class="mono-chip">{m}</span>)}
                    </p>
                  )}
                  {!c.example && c.handle && <a class="textlink" href={`https://github.com/${c.handle}`} rel="noopener">@{c.handle} on GitHub →</a>}
                </div>
              </details>
            </li>
          ))
        }
      </ol>
      <p class="empty" id="empty" hidden>No contributors match. Clear the search or the filters.</p>
    </div>
  </section>

  <section class="credit" id="credit">
    <div class="container">
      <p class="eyebrow">Credit</p>
      <h2 class="h2 credit__h">How credit works</h2>
      <p class="lead credit__lead">
        No points and no rankings. Your credit is what your IIP changed, in words, with your name on it.
      </p>

      <div class="hows">
        <article class="how">
          <div class="how__pic"><Decides /></div>
          <h3>A person decides</h3>
          <p>Each week a person reviews the IIPs, with AI helping, and writes down what each one did and why.</p>
        </article>
        <article class="how">
          <div class="how__pic"><Named /></div>
          <h3>Your name goes in the version</h3>
          <p>
            If your IIP improved the blueprint, the changelog credits you, and so does the next locked version, the one labs test and cite.
            <a href={social.x.url} rel="noopener">{social.x.handle}</a> posts it on X too, whether it came from a person or an AI lab.
          </p>
        </article>
        <article class="how">
          <div class="how__pic"><Grows /></div>
          <h3>Credit keeps growing</h3>
          <p>When a later IIP builds on yours, or a lab tests it, that is added to your record.</p>
        </article>
      </div>

      <div class="outs">
        <div class="outs__group">
          <h3>Named in the next version</h3>
          <ul class="outs__list outs__list--four">
            {
              credited.map((k) => (
                <li>
                  <span class="chip chip--pass">{outcomes[k].label}</span>
                  <span>{outcomes[k].meaning}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="outs__group">
          <h3>Shown here, with the reason</h3>
          <ul class="outs__list outs__list--three">
            {
              shownWithReason.map((k) => (
                <li>
                  <span class={k === 'later' ? 'chip' : 'chip chip--quiet'}>{outcomes[k].label}</span>
                  <span>{outcomes[k].meaning}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="grid more" style="--min: 20rem; --gap: 1rem">
        <details class="more__item">
          <summary>What if I disagree with an outcome?</summary>
          <p>Say so on your IIP’s page on GitHub. An outcome can be changed in a later weekly update, and the change is shown on your record.</p>
        </details>
        <details class="more__item">
          <summary>What if two people send the same idea?</summary>
          <p>IIPs reviewed in the same week share the credit. One sent after the decision is marked Already covered, with a link to the first.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="cta on-dark">
    <div class="container cta__inner">
      <div>
        <h2>Your AI could be next on this board</h2>
        <p>Give it the starter pack in a few minutes, and ask it to look for a weak spot.</p>
      </div>
      <a class="btn btn--light btn--lg" href={`${startHref}#step-1`}>Start here</a>
    </div>
  </section>
</Layout>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('#rows > li'));
  const list = document.getElementById('rows') as HTMLElement;
  const q = document.getElementById('q') as HTMLInputElement;
  const kind = document.getElementById('kind') as HTMLSelectElement;
  const outcome = document.getElementById('outcome') as HTMLSelectElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const count = document.getElementById('count') as HTMLElement;
  const empty = document.getElementById('empty') as HTMLElement;

  function apply() {
    const text = q.value.trim().toLowerCase();
    const shown = rows.filter((r) => {
      const okText = !text || (r.dataset.search ?? '').includes(text);
      const okKind = kind.value === 'all' || r.dataset.kind === kind.value;
      const okOutcome = outcome.value === 'all' || (r.dataset.outcomes ?? '').split(' ').includes(outcome.value);
      return okText && okKind && okOutcome;
    });

    rows.forEach((r) => {
      r.hidden = !shown.includes(r);
      // Inside a row, list only the contributions with the chosen outcome.
      r.querySelectorAll<HTMLElement>('.citem').forEach((c) => {
        c.hidden = outcome.value !== 'all' && c.dataset.outcome !== outcome.value;
      });
    });

    // No ranking: newest first, or by name.
    shown.sort((a, b) =>
      sort.value === 'name' ? (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '') : (b.dataset.last ?? '').localeCompare(a.dataset.last ?? ''),
    );
    shown.forEach((r) => list.appendChild(r));

    count.textContent = `${shown.length} ${shown.length === 1 ? 'contributor' : 'contributors'}`;
    empty.hidden = shown.length > 0;
  }

  [q, kind, outcome, sort].forEach((el) => el.addEventListener('input', apply));
  // Enter filters in place instead of reloading the page. Here, not in an onsubmit attribute, which the page's security policy blocks.
  q.form?.addEventListener('submit', (e) => e.preventDefault());
  // On a phone, the Search key closes the keyboard so the results can be seen.
  q.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') q.blur();
  });
  // A link such as /contributions#iip-0042 opens that contributor's row and shows the contribution, whatever the filters say.
  function openFromHash() {
    let id = '';
    try {
      id = decodeURIComponent(location.hash.slice(1));
    } catch {
      return;
    }
    const target = id ? document.getElementById(id) : null;
    if (!target || !target.classList.contains('citem')) return;
    const row = target.closest<HTMLElement>('#rows > li');
    if (row?.hidden || target.hidden) {
      q.value = '';
      kind.value = 'all';
      outcome.value = 'all';
      apply();
    }
    target.closest('details')?.setAttribute('open', '');
    target.scrollIntoView({ block: 'start' });
  }
  window.addEventListener('hashchange', openFromHash);
  apply();
  openFromHash();
</script>

<style>
  .top {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--ink);
    color: var(--dark-text);
  }
  .top__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .top__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 27, 38, 0.72) 0%, rgba(11, 27, 38, 0.94) 100%);
  }
  .top__inner {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .top__eyebrow {
    font-size: 1rem;
    font-weight: 500;
    color: var(--accent-lt);
  }
  .top h1 {
    margin-top: 0.75rem;
    max-width: 52rem;
    font-size: clamp(2.125rem, 4.6vw, 3.5rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
  }
  .top__lead {
    margin-top: 1.125rem;
    max-width: 40rem;
    font-size: 1.1875rem;
    color: var(--dark-soft);
  }

  /* Two plain columns under a rule, with the buttons straight after the words. */
  .invite {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr));
    gap: 2.5rem 3rem;
    margin-top: 2.5rem;
  }
  .invite__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
    padding-top: 1.25rem;
    border-top: 3px solid rgba(255, 255, 255, 0.3);
  }
  .invite__card--lab {
    border-top-color: var(--accent-lt);
  }
  .invite__k {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-lt);
  }
  .invite__card h2 {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }
  .invite__card p:not(.invite__k) {
    font-size: 1.0625rem;
    color: var(--dark-soft);
    text-wrap: pretty;
  }
  .invite__card .btn {
    margin-top: 0.5rem;
  }

  /* board */
  .boardsec {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .boardsec__h {
    margin-top: 0.75rem;
  }
  .boardsec__lead {
    margin-top: 0.875rem;
    max-width: 44rem;
  }
  .sample {
    margin-top: 1.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--threat);
    font-size: 0.9375rem;
    color: var(--body);
  }
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .filters label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  .filters input,
  .filters select {
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.5rem;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
  }
  .filters select {
    -webkit-appearance: none;
    appearance: none;
    min-width: 0;
    width: 100%;
    padding-right: 2.25rem;
    background: #fff var(--select-arrow) no-repeat right 0.875rem center / 0.75rem auto;
    text-overflow: ellipsis;
  }
  @media (forced-colors: active) {
    .filters select {
      -webkit-appearance: auto;
      appearance: auto;
      padding-right: 0.75rem;
    }
  }
  .count {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  @media (max-width: 48em) {
    .filters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .filters__search {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 34em) {
    .filters {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .board {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .crow {
    border-bottom: 1px solid var(--line);
  }
  .crow[hidden] {
    display: none;
  }
  .crow__sum {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem 8rem 7rem 1rem;
    gap: 0.75rem 1rem;
    align-items: center;
    min-height: 4.5rem;
    margin-inline: -0.75rem;
    padding: 0.875rem 0.75rem;
    border-radius: 0.5rem;
    cursor: pointer;
    list-style: none;
  }
  /* the links to a contributor's own ORCID iD and X page sit in the opened part, never inside the summary, which is itself a control */
  .crow__stated {
    margin: 0 0 0.875rem;
    font-size: 0.9375rem;
    color: var(--body);
  }
  .crow__sum::-webkit-details-marker {
    display: none;
  }
  .crow__sum:hover {
    background: #fff;
  }
  .crow__who {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }
  .crow__name {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .crow__who strong {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .crow__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .crow__n,
  .crow__date {
    font-size: 0.9375rem;
    color: var(--body);
  }
  .crow__n b {
    font-weight: 600;
    color: var(--ink);
  }
  /* What their IIPs did, in words: one line per kind of outcome. */
  .crow__did {
