---
import Layout from '../layouts/Layout.astro';
import CopyBox from '../components/CopyBox.astro';
import { rules, levelLabel, levelClass, levelMeaning, blockCount, warnCount, testNames } from '../data/graveyard';
import { pubmed, longDate, startHref } from '../data/site';

const checkPrompt = 'Check this design against the OpenIslet Idea Graveyard and explain any problems: [describe your design here]';
const firstSentence = (s: string) => s.split(/(?<=\.)\s/)[0];
---

<Layout
  title="Idea Graveyard"
  description="A public list of ideas that have been ruled out on paper, or flagged as risky, so nobody repeats a dead end. None has been tested in a lab. Newest first, and filterable."
  current="graveyard"
  share="idea-graveyard"
>
  <section class="intro">
    <div class="container">
      <p class="eyebrow">Idea Graveyard</p>
      <h1 class="h1 intro__h">Ideas ruled out on paper, or flagged as risky</h1>
      <p class="lead intro__lead">
        A public list of ideas that the evidence argues against, or that carry a risk that needs a check. These are checks on paper: none has been tested in a lab.
        It is here so nobody repeats a dead end. Newest first.
      </p>

      <ul class="stats" aria-label="What is on the list">
        <li><b>{rules.length}</b> ideas</li>
        <li><span class="chip chip--block">Dead end</span> <b>{blockCount}</b><span>{levelMeaning('BLOCK')}</span></li>
        <li><span class="chip chip--warn">Risky</span> <b>{warnCount}</b><span>{levelMeaning('WARN')}</span></li>
      </ul>
    </div>
  </section>

  <section class="listsec">
    <div class="container">
      <form class="filters" role="search">
        <label class="filters__search">
          <span>Search</span>
          <input id="q" type="search" placeholder="A gene, a word, or a number like GY-004" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="search" />
        </label>
        <label>
          <span>Status</span>
          <select id="level">
            <option value="all">All</option>
            <option value="BLOCK">Dead ends</option>
            <option value="WARN">Risky</option>
          </select>
        </label>
        <label>
          <span>Test</span>
          <select id="test">
            <option value="all">All tests</option>
            {Object.entries(testNames).map(([id, name]) => <option value={id}>{name}</option>)}
          </select>
        </label>
        <label>
          <span>Sort by</span>
          <select id="sort">
            <option value="new">Newest first</option>
            <option value="old">Oldest first</option>
          </select>
        </label>
      </form>
      <p class="count" id="count" aria-live="polite"></p>

      <ol class="list" id="list">
        {
          rules.map((r) => (
            <li
              class="entry"
              data-level={r.level}
              data-tests={r.tests.join(' ')}
              data-date={r.added}
              data-ver={r.version}
              data-id={r.id}
              data-search={`${r.id} ${r.title} ${r.idea} ${r.why} ${r.instead}`.toLowerCase()}
            >
              <details id={r.id.toLowerCase()}>
                <summary>
                  <span class="entry__top">
                    <span class={levelClass(r.level)}>{levelLabel(r.level)}</span>
                    <span class="entry__id mono">{r.id}</span>
                    <time class="entry__date" datetime={r.added}>{longDate(r.added)}</time>
                  </span>
                  <span class="entry__title">{r.title}</span>
                  <span class="entry__why">{firstSentence(r.why)}</span>
                  <span class="entry__tests">
                    {r.tests.map((t) => <span class="chip chip--quiet">{testNames[t]}</span>)}
                  </span>
                  <svg class="entry__chev" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </summary>

                <div class="entry__body">
                  <dl class="entry__grid">
                    <div><dt>The idea</dt><dd>{r.idea}</dd></div>
                    <div><dt>Why it fails</dt><dd>{r.why}</dd></div>
                    <div><dt>What would settle it</dt><dd>{r.check}</dd></div>
                    <div><dt>What to do instead</dt><dd>{r.instead}</dd></div>
                  </dl>
                  <div class="entry__meta">
                    <p><span class="chip">{r.confidence}</span> {r.basis && <span class="chip chip--quiet">{r.basis}</span>}</p>
                    {r.papers.length > 0 && (
                      <p class="entry__papers">
                        <span>Papers:</span>
                        {r.papers.map((p) => <a class="pmid" href={pubmed(p)} target="_blank" rel="noopener">PMID {p}</a>)}
                      </p>
                    )}
                    <p class="footnote">
                      Added {longDate(r.added)}, blueprint {r.version}.
                      {r.contribution && <> Contribution <a href="/contributions#board" class="mono">{r.contribution}</a>.</>}
                    </p>
                  </div>
                </div>
              </details>
            </li>
          ))
        }
      </ol>
      <p class="empty" id="empty" hidden>Nothing matches. Clear the search or the filters.</p>

      <div class="grid more" style="--min: 24rem; --gap: 2rem 3rem">
        <div class="fact">
          <h2>Check a whole design against this list</h2>
          <p>Once your AI has the blueprint, it can test any design against every idea here at once. Paste this, and describe your design.</p>
          <CopyBox label="Prompt" text={checkPrompt} />
          <a class="textlink" href={`${startHref}#step-1`}>Give your AI the blueprint first →</a>
        </div>
        <div class="fact">
          <h2>Found a dead end in the blueprint?</h2>
          <p>
            Test it with your AI first, using the blind second opinion in the Start here guide. If the review says Supported or Partly
            supported, submit it, and it can join this list. IIPs the review does not support are not submitted.
          </p>
          <a class="btn btn--primary" href={`${startHref}#step-4`}>How to test and submit an idea</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('#list > li'));
  const list = document.getElementById('list') as HTMLElement;
  const q = document.getElementById('q') as HTMLInputElement;
  const level = document.getElementById('level') as HTMLSelectElement;
  const test = document.getElementById('test') as HTMLSelectElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const count = document.getElementById('count') as HTMLElement;
  const empty = document.getElementById('empty') as HTMLElement;

  function apply() {
    const text = q.value.trim().toLowerCase();
    const shown = items.filter((li) => {
      const okText = !text || (li.dataset.search ?? '').includes(text);
      const okLevel = level.value === 'all' || li.dataset.level === level.value;
      const okTest = test.value === 'all' || (li.dataset.tests ?? '').split(' ').includes(test.value);
      return okText && okLevel && okTest;
    });
    items.forEach((li) => (li.hidden = !shown.includes(li)));

    // The page already lists newest first, so "oldest first" is that order reversed.
    const ordered = sort.value === 'old' ? [...items].reverse() : [...items];
    ordered.forEach((li) => list.appendChild(li));

    count.textContent = `Showing ${shown.length} of ${items.length}`;
    empty.hidden = shown.length > 0;
  }
  [q, level, test, sort].forEach((el) => el.addEventListener('input', apply));
  // Enter filters in place instead of reloading the page. Here, not in an onsubmit attribute, which the page's security policy blocks.
  q.form?.addEventListener('submit', (e) => e.preventDefault());
  // On a phone, the Search key closes the keyboard so the results can be seen.
  q.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') q.blur();
  });
  apply();

  // Links such as /idea-graveyard#gy-004 open that entry (and the old /graveyard#gy-004, which forwards here).
  function openHash() {
    const id = location.hash.slice(1);
    const el = id ? (document.getElementById(id) as HTMLDetailsElement | null) : null;
    if (!el || !el.closest('#list')) return;
    const li = el.closest('li') as HTMLElement;
    if (li.hidden) {
      q.value = '';
      level.value = 'all';
      test.value = 'all';
      apply();
    }
    el.open = true;
    li.scrollIntoView({ block: 'start' });
  }
  window.addEventListener('hashchange', openHash);
  openHash();
</script>

<style>
  .intro {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .intro__h {
    margin-top: 0.75rem;
    max-width: 56.25rem;
  }
  .intro__lead {
    margin-top: 1.125rem;
    max-width: 46.25rem;
  }
  .stats {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    font-size: 1rem;
    color: var(--body);
  }
  @media (max-width: 75em) {
    .stats {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .stats li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .stats b {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink);
  }
  .stats span:last-child:not(.chip) {
    font-size: 0.9375rem;
  }

  .listsec {
    padding-block: 2rem clamp(3rem, 6vw, 5rem);
  }
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .filters label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  .filters input,
  .filters select {
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.5rem;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
  }
  .count {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .filters input,
  .filters select {
    min-width: 0;
    width: 100%;
  }
  .filters select {
    -webkit-appearance: none;
    appearance: none;
    padding-right: 2.25rem;
    background: #fff var(--select-arrow) no-repeat right 0.875rem center / 0.75rem auto;
    text-overflow: ellipsis;
  }
  @media (forced-colors: active) {
    .filters select {
      -webkit-appearance: auto;
      appearance: auto;
      padding-right: 0.75rem;
    }
  }
  @media (max-width: 48em) {
    .filters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .filters__search {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 34em) {
    .filters {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The ideas are a list of rows between hairlines, each one folded. */
  .list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .entry {
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 1.5rem;
  }
  .entry[hidden] {
    display: none;
  }
  .entry summary {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1rem;
    gap: 0.375rem 1rem;
    align-items: start;
    margin-inline: -0.75rem;
    padding: 1rem 0.75rem;
    border-radius: 0.5rem;
    cursor: pointer;
    list-style: none;
  }
  .entry summary::-webkit-details-marker {
    display: none;
  }
  .entry summary:hover {
    background: #fff;
  }
  .entry__top {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.75rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .entry__id {
    font-size: 0.8125rem;
  }
  .entry__title {
    grid-column: 1;
    font-size: 1.1875rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .entry__why {
    grid-column: 1;
    font-size: 0.96875rem;
    color: var(--body);
    text-wrap: pretty;
  }
  .entry__tests {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }
  .entry__chev {
    grid-column: 2;
    grid-row: 1 / span 4;
    align-self: center;
    color: var(--muted);
    transition: transform 0.15s;
  }
  details[open] > summary .entry__chev {
    transform: rotate(180deg);
  }
  .entry__body {
    padding: 0.25rem 0 1.25rem;
  }
  .entry__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2rem;
    margin: 1rem 0 0;
  }
  @media (max-width: 40em) {
    .entry__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .entry__grid dt {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  .entry__grid dd {
    margin: 0.25rem 0 0;
    font-size: 1rem;
    text-wrap: pretty;
  }
  .entry__meta {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
  }
  /* The chips and paper links sit in rows; the credit line is plain text, so its full stop stays next to its link. */
  .entry__meta p:not(.footnote) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .entry__papers > span {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  .empty {
    margin-top: 1rem;
    padding: 1.25rem 0;
    color: var(--body);
  }

  .more {
    margin-top: 2.5rem;
  }
  .more .fact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .more h2 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .more p {
    font-size: 1rem;
    color: var(--body);
    text-wrap: pretty;
  }
  .more :global(.copybox) {
    align-self: stretch;
  }
</style>
