---
import Layout from '../layouts/Layout.astro';
import { startHref, contact } from '../data/site';

// Six places, so the cards sit in even rows of three, two or one.
const places = [
  { href: '/#problem', name: 'The problem', text: 'What type 1 diabetes does, and why a cure has been so hard to find.' },
  { href: startHref, name: 'Start here', text: 'Help in six steps, with your AI assistant doing the thinking.' },
  { href: '/blueprint', name: 'Blueprint', text: 'The design, the five tests it must pass and the evidence behind it.' },
  { href: '/idea-graveyard', name: 'Idea Graveyard', text: 'Ideas ruled out on paper, or flagged as risky, so nobody repeats them.' },
  { href: '/roadmap', name: 'Roadmap', text: 'The seven stages from blueprint to patients.' },
  { href: '/contributions', name: 'Contributions', text: 'Who has helped, and what they did.' },
];
---

<Layout title="Page not found" description="That page is not on OpenIslet. Here are the places most people are looking for." noindex>
  <section class="nf">
    <div class="container">
      <svg class="nf__pic" viewBox="0 0 160 64" width="160" height="64" aria-hidden="true" focusable="false">
        <circle cx="40" cy="32" r="22" fill="var(--cell-beta)" stroke="var(--ink)" stroke-width="2"></circle>
        <circle cx="34" cy="37" r="8" fill="var(--ink)" fill-opacity="0.28"></circle>
        <circle cx="118" cy="32" r="22" fill="none" stroke="var(--accent)" stroke-width="3" stroke-dasharray="5 6" stroke-linecap="round"></circle>
        <text x="118" y="42" text-anchor="middle" font-size="28" font-weight="600" fill="var(--accent)" style="font-family: var(--sans)">?</text>
      </svg>
      <p class="eyebrow">Page not found</p>
      <h1 class="h1 nf__h">That page isn’t here</h1>
      <p class="lead nf__lead">The link may be old, or mistyped. These are the places most people are looking for.</p>

      <ul class="nf__cards">
        {
          places.map((p) => (
            <li>
              <a class="nf__card" href={p.href}>
                <span class="nf__name">{p.name}</span>
                <span class="nf__text">{p.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="nf__tell">Found a broken link on our site? <a class="textlink" href={`mailto:${contact.email}?subject=${encodeURIComponent('A broken link on OpenIslet')}`}>Tell us</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .nf {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .nf__pic {
    display: block;
    margin-bottom: 1.5rem;
  }
  .nf__h {
    max-width: 40rem;
  }
  .nf__lead {
    margin-top: 0.75rem;
    max-width: 40rem;
  }
  .nf__cards {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  /* Each place is a link: plain words under a rule, which turns blue when the pointer is on it. */
  .nf__card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    height: 100%;
    padding-top: 1.25rem;
    border-top: 3px solid var(--line-strong);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .nf__card:hover,
  .nf__card:focus-visible {
    border-top-color: var(--accent);
  }
  .nf__card:hover .nf__name {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .nf__name {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .nf__text {
    color: var(--body);
  }
  .nf__tell {
    margin-top: 1.5rem;
    color: var(--body);
  }
  @media (max-width: 62rem) {
    .nf__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 36rem) {
    .nf__cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
