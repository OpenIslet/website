---
// Shows why studies differ: a dish, a mouse, donated tissue and a person are four separate lanes. Two results that point
// in opposite directions sit in different lanes, so they are never stacked on one scale.
import Cell from '../art/Cell.astro';
import Person from '../art/Person.astro';
---

<svg viewBox="0 0 240 110" role="img" aria-label="Four separate lanes: cells in a dish, a mouse, donated tissue and a person. A result pointing up sits in the dish lane and a result pointing down sits in the mouse lane.">
  <g stroke="#a6b6c2" stroke-opacity="0.45" stroke-width="1.5" stroke-dasharray="3 5">
    <line x1="66" y1="10" x2="66" y2="102"></line>
    <line x1="120" y1="10" x2="120" y2="102"></line>
    <line x1="174" y1="10" x2="174" y2="102"></line>
  </g>

  <!-- results, each in its own lane -->
  <circle cx="39" cy="34" r="16" fill="#0b1b26" stroke="#7be0b8" stroke-width="2.5"></circle>
  <path d="M39 43 V26 M32 32.5 L39 25 L46 32.5" stroke="#7be0b8" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
  <circle cx="93" cy="34" r="16" fill="#0b1b26" stroke="#f2a93b" stroke-width="2.5"></circle>
  <path d="M93 25 V42 M86 35.5 L93 43 L100 35.5" stroke="#f2a93b" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
  <circle cx="147" cy="34" r="15" fill="none" stroke="#a6b6c2" stroke-opacity="0.4" stroke-width="2" stroke-dasharray="3 5"></circle>
  <circle cx="201" cy="34" r="15" fill="none" stroke="#a6b6c2" stroke-opacity="0.4" stroke-width="2" stroke-dasharray="3 5"></circle>

  <!-- cells in a dish -->
  <path d="M21 80 v8 a18 5.5 0 0 0 36 0 v-8" fill="#13293a" stroke="#8ea0ff" stroke-width="2" stroke-linejoin="round"></path>
  <ellipse cx="39" cy="80" rx="18" ry="5.5" fill="#0b1b26" stroke="#8ea0ff" stroke-width="2"></ellipse>
  <circle cx="32" cy="80" r="2.5" fill="#5b73ff"></circle>
  <circle cx="40" cy="81.5" r="2.5" fill="#5b73ff"></circle>
  <circle cx="47" cy="79.5" r="2.5" fill="#5b73ff"></circle>

  <!-- a mouse -->
  <path d="M80 90 C73 92, 72 82, 78 80" stroke="#e6edf2" stroke-width="2" fill="none" stroke-linecap="round"></path>
  <ellipse cx="91" cy="87" rx="13" ry="8.5" fill="#e6edf2" stroke="#0b1b26" stroke-width="2"></ellipse>
  <path d="M100 81 L113 88 L101 93 Z" fill="#e6edf2" stroke="#0b1b26" stroke-width="2" stroke-linejoin="round"></path>
  <circle cx="100" cy="79" r="4.5" fill="#e6edf2" stroke="#0b1b26" stroke-width="2"></circle>
  <circle cx="105" cy="86.5" r="1.3" fill="#0b1b26"></circle>

  <!-- donated tissue -->
  <Cell x={142} y={86} r={9} kind="beta" />
  <Cell x={155} y={81} r={6.5} kind="alpha" />
  <Cell x={154} y={94} r={5} kind="beta" />

  <!-- a person -->
  <g transform="translate(201 74) scale(0.6)">
    <Person x={0} y={0} />
  </g>
</svg>
