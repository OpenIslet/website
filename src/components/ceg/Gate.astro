  <rect x="22" y="41" width="32" height="4.5" rx="2.25" fill="#e6edf2" fill-opacity="0.7"></rect>
  <rect x="22" y="50" width="38" height="4.5" rx="2.25" fill="#e6edf2" fill-opacity="0.45"></rect>

  <!-- to the checkpoint -->
  <path d="M84 43 H102" stroke="#e6edf2" stroke-width="2.5" stroke-dasharray="3 5" fill="none" stroke-linecap="round"></path>

