  <circle cx="184" cy="86" r="8" fill="#5b73ff" stroke="#0b1b26" stroke-width="2.5"></circle>
  <circle cx="168" cy="43" r="10" fill="#5b73ff" stroke="#7be0b8" stroke-width="3"></circle>
