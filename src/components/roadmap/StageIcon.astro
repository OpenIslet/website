---
// A small line icon for each stage, used on the route buttons at the top of the roadmap.
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {id === '0' && <path d="M7 3h7l4 4v14H7z M14 3v4h4 M9.5 14l2 2 3.5-4" />}
  {id === '1' && <path d="M9 3h6 M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3 M8 14h8" />}
  {id === '2' && <path d="M12 3c3 4 6 7 6 11a6 6 0 0 1-12 0c0-4 3-7 6-11z M9.5 15a2.5 2.5 0 0 0 2.5 2.5" />}
  {
    id === '3' && (
      <g fill="currentColor" stroke="none">
        <circle cx="6.5" cy="11" r="2" />
        <circle cx="10" cy="7" r="2" />
        <circle cx="14" cy="7" r="2" />
        <circle cx="17.5" cy="11" r="2" />
        <path d="M12 12.5c-3 0-5.5 3.2-5.5 5.4 0 1.7 1.3 2.6 2.8 2.6 1 0 1.7-.5 2.7-.5s1.7.5 2.7.5c1.5 0 2.8-.9 2.8-2.6 0-2.2-2.5-5.4-5.5-5.4z" />
      </g>
    )
  }
  {id === '4' && <path d="M9 4.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M3.5 20v-1.5a5.5 5.5 0 0 1 11 0V20 M18 7v6 M15 10h6" />}
  {id === '5' && <path d="M8 3c0 4 8 5 8 9s-8 5-8 9 M16 3c0 4-8 5-8 9s8 5 8 9 M9 8h6 M9 16h6" />}
</svg>
