---
// Stage 4: clinical-grade cells and regulator checks. Frozen cell banks (one master vial, working vials grown from it), a locked
// recipe, and a batch that passes every check, with a row of identical batches underneath.
// No numbers here: the project keeps the detail of Stages 1 to 6 off the site.
---

<svg viewBox="0 0 280 176" role="img" aria-label="Frozen cell banks on the left: one master vial and a row of working vials grown from it. In the middle, a recipe sheet with a padlock on it. On the right, a batch of cells above a checklist with every line ticked. Along the bottom, a row of identical batches.">
  <!-- frozen: a snowflake over the bank -->
  <g stroke="#8ea0ff" stroke-width="2.2" stroke-linecap="round" fill="none">
    <path d="M66 10v18M58.2 14.5l15.6 9M73.8 14.5l-15.6 9"></path>
  </g>

  <!-- the master vial -->
  <rect x="20" y="46" width="24" height="52" rx="8" fill="#e6edf2" stroke="#0b1b26" stroke-width="2.5"></rect>
  <path d="M22.5 68 H41.5 V90 a6 6 0 0 1 -6 6 H28.5 a6 6 0 0 1 -6 -6 Z" fill="#5b73ff"></path>
  <rect x="18" y="38" width="28" height="12" rx="4" fill="#f2a93b" stroke="#0b1b26" stroke-width="2.5"></rect>

  <!-- the working vials grown from it -->
  <path d="M49 74 H59" stroke="#e6edf2" stroke-width="2.5" stroke-linecap="round" fill="none"></path>
  <path d="M55.5 69.5 L60 74 L55.5 78.5" stroke="#e6edf2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
  {
    [66, 86, 106].map((x) => (
      <g>
        <rect x={x} y="60" width="15" height="38" rx="6" fill="#e6edf2" stroke="#0b1b26" stroke-width="2.2"></rect>
        <path d={`M${x + 2.2} 76 H${x + 12.8} V92 a4 4 0 0 1 -4 4 H${x + 6.2} a4 4 0 0 1 -4 -4 Z`} fill="#5b73ff"></path>
        <rect x={x - 1.5} y="54" width="18" height="9" rx="3" fill="#8ea0ff" stroke="#0b1b26" stroke-width="2.2"></rect>
      </g>
    ))
  }

  <!-- to the recipe -->
  <path d="M130 74 H140" stroke="#e6edf2" stroke-width="2.5" stroke-dasharray="3 5" stroke-linecap="round" fill="none"></path>

  <!-- the locked recipe -->
  <rect x="148" y="38" width="46" height="60" rx="5" fill="#e6edf2" stroke="#0b1b26" stroke-width="2.5"></rect>
  <g fill="#0b1b26" fill-opacity="0.38">
    <rect x="156" y="48" width="30" height="4.5" rx="2.25"></rect>
    <rect x="156" y="58" width="24" height="4.5" rx="2.25"></rect>
    <rect x="156" y="68" width="28" height="4.5" rx="2.25"></rect>
  </g>
  <path d="M179 86 v-6 a7 7 0 0 1 14 0 v6" fill="none" stroke="#0b1b26" stroke-width="6" stroke-linecap="round"></path>
  <path d="M179 86 v-6 a7 7 0 0 1 14 0 v6" fill="none" stroke="#f2a93b" stroke-width="2.6" stroke-linecap="round"></path>
  <rect x="173" y="85" width="26" height="21" rx="4.5" fill="#f2a93b" stroke="#0b1b26" stroke-width="2.5"></rect>
  <path d="M186 92.5 v6" stroke="#0b1b26" stroke-width="2.6" stroke-linecap="round"></path>

  <!-- to the checks -->
  <path d="M206 74 H216" stroke="#e6edf2" stroke-width="2.5" stroke-dasharray="3 5" stroke-linecap="round" fill="none"></path>

  <!-- a batch, and every check ticked -->
  <g stroke="#0b1b26" stroke-width="2.2">
    <circle cx="238" cy="42" r="10" fill="#5b73ff"></circle>
    <circle cx="254" cy="38" r="8" fill="#e6edf2"></circle>
    <circle cx="251" cy="53" r="7" fill="#5b73ff"></circle>
  </g>
  {
    [72, 88, 104].map((y, i) => (
      <g>
        <path d={`M226 ${y} l4 4 l7 -8.5`} fill="none" stroke="#f2a93b" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"></path>
        <rect x="243" y={y - 3} width={i === 1 ? 20 : 27} height="5" rx="2.5" fill="#e6edf2" fill-opacity={0.9 - i * 0.18}></rect>
      </g>
    ))
  }

  <g font-family="IBM Plex Sans, sans-serif" font-size="11.5" font-weight="600" fill="#e6edf2" text-anchor="middle">
    <text x="32" y="114">master</text>
    <text x="93" y="114">working</text>
    <text x="172" y="122">locked</text>
    <text x="249" y="122">checked</text>
  </g>

  <!-- every batch the same -->
  <line x1="20" y1="136" x2="260" y2="136" stroke="#8ea0ff" stroke-opacity="0.3" stroke-width="1.5"></line>
  {
    [86, 122, 158, 194].map((x, i) => (
      <g>
        <circle cx={x} cy="155" r="8.5" fill="#5b73ff" stroke="#0b1b26" stroke-width="2.2"></circle>
        <circle cx={x - 1.2} cy="155.8" r="3" fill="#0b1b26" fill-opacity="0.28"></circle>
        {i < 3 && <path d={`M${x + 14} 152.5 h8 M${x + 14} 157.5 h8`} stroke="#e6edf2" stroke-width="2.2" stroke-linecap="round"></path>}
      </g>
    ))
  }
</svg>
