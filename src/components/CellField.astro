---
// A soft, out-of-focus field of islet cells, drawn in code so it needs no photo.
// About 60% beta, 30% alpha and 10% delta cells, the same mix as the logo. Three layers of blur give depth.
interface Props {
  seed?: number;
  count?: number;
  /** "dark" glows on a dark background. "light" is faint ink on a light one. */
  tone?: 'dark' | 'light';
}
const { seed = 7, count = 54, tone = 'dark' } = Astro.props;

function random(seed: number) {
  let t = seed >>> 0;
  return () => {
    t += 0x6d2b79f5;
    let r = Math.imul(t ^ (t >>> 15), 1 | t);
    r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);
    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = random(seed);

const colour =
  tone === 'dark'
    ? { beta: '#5b73ff', alpha: '#c9d3ff', delta: '#8ea0ff', ring: '#8ea0ff', nucleus: '#0b1b26' }
    : { beta: '#2a3fd6', alpha: '#0b1b26', delta: '#2a3fd6', ring: '#2a3fd6', nucleus: '#0b1b26' };

const cells = Array.from({ length: count }, () => {
  const pick = rand();
  const depth = rand();
  const r = Math.round(14 + rand() * 56);
  return {
    kind: (pick < 0.6 ? 'beta' : pick < 0.9 ? 'alpha' : 'delta') as 'beta' | 'alpha' | 'delta',
    x: Math.round(rand() * 1600),
    y: Math.round(rand() * 700),
    r,
    layer: depth < 0.4 ? 0 : depth < 0.75 ? 1 : 2,
    o: Math.round((0.35 + rand() * 0.5) * 100) / 100,
    nx: Math.round((rand() - 0.5) * r * 0.4),
    ny: Math.round((rand() - 0.5) * r * 0.4),
    // A few small bright spots inside each cell, like organelles under a microscope.
    dots: Array.from({ length: 4 }, () => {
      const a = rand() * Math.PI * 2;
      const d = rand() * r * 0.75;
      return { x: Math.round(Math.cos(a) * d), y: Math.round(Math.sin(a) * d), r: Math.max(1.5, Math.round(r * (0.04 + rand() * 0.05))) };
    }),
  };
});
// Tiny drifting particles in the background.
const particles = Array.from({ length: Math.round(count * 1.6) }, () => ({
  x: Math.round(rand() * 1600),
  y: Math.round(rand() * 700),
  r: Math.round((1.5 + rand() * 3.5) * 10) / 10,
  o: Math.round((0.2 + rand() * 0.4) * 100) / 100,
}));
const layers = [0, 1, 2].map((l) => cells.filter((c) => c.layer === l));
const uid = `cf${seed}`;
---

<svg class="cellfield" viewBox="0 0 1600 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <filter id={`${uid}-b1`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="3"></feGaussianBlur></filter>
    <filter id={`${uid}-b2`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="9"></feGaussianBlur></filter>
    {
      (['beta', 'alpha', 'delta'] as const).map((k) => (
        <radialGradient id={`${uid}-${k}`} cx="42%" cy="40%" r="65%">
          <stop offset="0%" stop-color={colour[k]} stop-opacity="0.55"></stop>
          <stop offset="70%" stop-color={colour[k]} stop-opacity="0.2"></stop>
          <stop offset="100%" stop-color={colour[k]} stop-opacity="0.38"></stop>
        </radialGradient>
      ))
    }
  </defs>
  <g class="cellfield__layer cellfield__layer--2" filter={`url(#${uid}-b1)`} fill={colour.alpha}>
    {particles.map((p) => <circle cx={p.x} cy={p.y} r={p.r} fill-opacity={p.o}></circle>)}
  </g>
  {
    layers.map((group, l) => (
      <g filter={l === 0 ? undefined : `url(#${uid}-b${l})`} class={`cellfield__layer cellfield__layer--${l}`}>
        {group.map((c) => (
          <g opacity={c.o}>
            <circle cx={c.x} cy={c.y} r={c.r} fill={`url(#${uid}-${c.kind})`} stroke={colour.ring} stroke-opacity="0.55" stroke-width="2"></circle>
            <circle cx={c.x + c.nx} cy={c.y + c.ny} r={Math.round(c.r * 0.4)} fill={colour.nucleus} fill-opacity={tone === 'dark' ? 0.45 : 0.12}></circle>
            {c.dots.map((d) => (
              <circle cx={c.x + d.x} cy={c.y + d.y} r={d.r} fill={colour.alpha} fill-opacity="0.55"></circle>
            ))}
          </g>
        ))}
      </g>
    ))
  }
</svg>

<style>
  .cellfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
  .cellfield__layer--1 {
    animation: drift 46s ease-in-out infinite alternate;
  }
  .cellfield__layer--2 {
    animation: drift 70s ease-in-out infinite alternate-reverse;
  }
  @keyframes drift {
    from {
      transform: translate3d(-14px, 6px, 0);
    }
    to {
      transform: translate3d(16px, -10px, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cellfield__layer--1,
    .cellfield__layer--2 {
      animation: none;
    }
  }
</style>
