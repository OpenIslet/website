---
import Logo from './Logo.astro';
import { navItems, startHref } from '../data/site';

interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href="/" aria-label="OpenIslet home">
      <Logo size={32} />
      <span>OpenIslet</span>
    </a>
    <div class="nav__right">
      <nav aria-label="Primary" class="nav__links" data-sidescroll>
        {
          navItems.map((item) => (
            <a
              class="nav__link"
              href={item.href}
              aria-current={current === item.id ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <a class="btn btn--primary nav__cta" href={startHref} aria-current={current === 'start' ? 'page' : undefined}>Start here</a>
    </div>
  </div>
</header>

<style>
  .nav {
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    min-height: 4.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    color: var(--ink);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .nav__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
  }
  .nav__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.25rem;
  }
  .nav__link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }
  .nav__link:hover {
    color: var(--accent);
  }
  .nav__link[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
    box-shadow: inset 0 -3px 0 var(--accent);
  }
  .nav__cta {
    margin-left: 0.5rem;
  }

  /* Phones and tablets, where the six links and the button do not fit beside the logo: logo and the main button on one row,
     links in a single swipeable row below. */
  @media (max-width: 61em) {
    .nav__inner {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0;
      min-height: 0;
      padding-block: 0.25rem 0;
    }
    .nav__right {
      display: contents;
    }
    .nav__cta {
      grid-column: 2;
      grid-row: 1;
      margin-left: 0;
    }
    .nav__links {
      grid-column: 1 / -1;
      grid-row: 2;
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: calc(var(--gutter) - 0.75rem);
      scrollbar-width: none;
    }
    .nav__links::-webkit-scrollbar {
      display: none;
    }
  }
</style>
