---
// "Realistic chance of working": four hurdles, our computational estimate for each design (A, B, X) and for all three side by side,
// plus the combined head-to-head and portfolio figures. All numbers and per-hurdle wording live in src/data/success-probability.json.
import {
  oddsGates,
  oddsDesignA,
  oddsDesignB,
  oddsDesignX,
  oddsThree,
  oddsLastUpdated,
  oddsLaunchSingle,
  oddsLaunchThree,
  oddsPortfolioScenarios,
  wholePercent,
} from '../data/successProbability';
import { longDate, pubmed, release } from '../data/site';
import { draft } from '../data/versions';
import changelog from '../data/changelog.json';
import OddsArt from './odds/OddsArt.astro';

const latestBlueprintDate = changelog[0]?.date ?? release.date;

type PctKey = 'singleArmPct' | 'designBPct' | 'designXPct' | 'threeArmPct';
const formula = (key: PctKey) => oddsGates.map((g) => `${g[key]}%`).join(' × ');

const singleDesigns = [
  {
    id: 'X',
    name: 'Design X',
    sub: 'Simulated frontier upgrades',
    key: 'designXPct' as const,
    formula: formula('designXPct'),
    value: wholePercent(oddsDesignX),
  },
  {
    id: 'B',
    name: 'Design B',
    sub: 'Matched HLA-C and bead-free sheet',
    key: 'designBPct' as const,
    formula: formula('designBPct'),
    value: wholePercent(oddsDesignB),
  },
  {
    id: 'A',
    name: 'Design A',
    sub: 'Simplest baseline control',
    key: 'singleArmPct' as const,
    formula: formula('singleArmPct'),
    value: wholePercent(oddsDesignA),
  },
];

const scenBars = [
  { id: 'A', label: 'One design (Design A)', key: 'singleArmPct' as const },
  { id: 'B', label: 'One design (Design B)', key: 'designBPct' as const },
  { id: 'X', label: 'One design (Design X)', key: 'designXPct' as const },
];

const aVal = wholePercent(oddsDesignA);
const bVal = wholePercent(oddsDesignB);
const xVal = wholePercent(oddsDesignX);
const threeVal = wholePercent(oddsThree);
const threeFormula = formula('threeArmPct');
const sharedAxLockedVal = wholePercent(oddsPortfolioScenarios.sharedAxLockedPct);
const sharedAxLockedExact = oddsPortfolioScenarios.sharedAxLockedPct.toFixed(2);
const sharedAxModularVal = wholePercent(oddsPortfolioScenarios.sharedAxModularPct);
const sharedAxModularExact = oddsPortfolioScenarios.sharedAxModularPct.toFixed(2);
const legacyThreeLockedExact = oddsPortfolioScenarios.legacyThreeSlotLockedPct.toFixed(2);
const legacyThreeModularVal = wholePercent(oddsPortfolioScenarios.legacyThreeSlotModularPct);
const legacyThreeModularExact = oddsPortfolioScenarios.legacyThreeSlotModularPct.toFixed(2);
const ceilingExact = oddsPortfolioScenarios.commonShockCeilingPct.toFixed(2);

const chipClass = { shown: 'chip chip--pass', partial: 'chip', unknown: 'chip chip--warn' } as const;
---

<section class="odds" id="odds">
  <div class="container">
    <p class="eyebrow">Odds</p>
    <h2 class="h2">Chance of clearing four hurdles: our rough estimate</h2>
    <p class="lead odds__lead">
      Nobody can know yet, so we show our working instead of one confident number. We split the question into four hurdles a design has to
      clear, give our best computational estimate for each blueprint (use the Design A, B and X buttons above to switch the hurdle bars),
      and multiply them together.
    </p>

    <div class="odds__cards">
      {
        oddsGates.map((g) => (
          <article class="odd">
            <div class="odd__vis"><OddsArt id={g.id} /></div>
            <div class="odd__head">
              <p class="odd__n">Hurdle {g.number}</p>
              <span class={chipClass[g.badgeKind]}>{g.badge}</span>
            </div>
            <h3 class="odd__t">{g.title}</h3>
            <ul class="odd__est">
              <li>
                {scenBars.map((s) => (
                  <div class="odd__scen" data-scen={s.id} hidden={s.id !== 'A'}>
                    <span class="odd__lab">{s.label}</span>
                    <strong class="mono odd__pct">{g[s.key]}%</strong>
                    <span class="bar odd__bar" aria-hidden="true"><span style={`width:${g[s.key]}%`}></span></span>
                  </div>
                ))}
              </li>
              <li class="odd__row">
                <span class="odd__lab">Three side by side</span>
                <strong class="mono odd__pct">{g.threeArmPct}%</strong>
                <span class="bar odd__bar odd__bar--three" aria-hidden="true"><span style={`width:${g.threeArmPct}%`}></span></span>
              </li>
            </ul>
            <p class="odd__plain pretty">{g.plain}</p>
            <p class="odd__ev footnote">
              {g.evidence}
              {g.pmid && <> <a href={pubmed(g.pmid)} target="_blank" rel="noopener">PMID {g.pmid}</a></>}
              {g.followUpPmid && <> (14-month follow-up, n = 1: <a href={pubmed(g.followUpPmid)} target="_blank" rel="noopener">PMID {g.followUpPmid}</a>)</>}
              {g.next && <span class="odd__next">{g.next}</span>}
            </p>
          </article>
        ))
      }
    </div>

    <div class="card odds__sum">
      <h3 class="h3">Putting the four hurdles together</h3>
      <p class="odds__scope">
        These are our computational judgements for four hurdles, each for a design still in the running. They assume this product’s cells
        work as designed and pass the lab safety checks before any trial, so they are not the chance of a cure.
      </p>
      <div class="odds__results">
        <div class="res">
          <p class="res__k"><strong>One design on its own, first try</strong> <span>All three blueprints modelled head to head</span></p>
          <ul class="res__stack">
            {
              singleDesigns.map((d) => (
                <li class="res__item">
                  <div class="res__itemhead">
                    <p class="res__name"><strong>{d.name}</strong> <span>{d.sub}</span></p>
                    <p class="res__mid mono"><span class="res__about">about</span> {d.value}%</p>
                  </div>
                  <span class="bar res__bar" aria-hidden="true"><span style={`width:${d.value}%`}></span></span>
                  <p class="res__formula mono">{d.formula}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="res res--three">
          <p class="res__k"><strong>Three designs tested side by side</strong> <span>Designs A, B and X · two pouch routes</span></p>
          <p class="res__big mono"><span class="res__about">about</span> {sharedAxModularVal}% <span class="res__mod">(modular)</span></p>
          <span class="bar res__bar" aria-hidden="true"><span style={`width:${sharedAxModularVal}%`}></span></span>
          <p class="res__formula mono">Exact 2<sup>12</sup> model: {sharedAxModularExact}% modular · {sharedAxLockedExact}% locked</p>
          <p class="res__why pretty">
            <strong>What modular means:</strong> Designs A and X share the calcium-peroxide + catalase pouch while Design B uses a bead-free pre-vascularized sheet. <strong>About {sharedAxModularVal}% ({sharedAxModularExact}%)</strong> pairs the winning cell line with the winning pouch once Stage-0 compatibility checks pass.
          </p>
          <p class="res__why pretty">
            <strong>Without mixing parts (locked):</strong> <strong>about {sharedAxLockedVal}% ({sharedAxLockedExact}%)</strong> if one fixed blueprint must clear all four hurdles on its own. Shared biology across all three designs sets a hard ceiling of <strong>{ceilingExact}%</strong> (legacy three-slot approximation: about {threeVal}% / {legacyThreeLockedExact}% locked via {threeFormula}; about {legacyThreeModularVal}% / {legacyThreeModularExact}% modular).
          </p>
        </div>
      </div>
      <p class="odds__rule">Single-design odds = hurdle 1 × hurdle 2 × hurdle 3 × hurdle 4. Side-by-side odds come from the exact 4,096-state (2<sup>12</sup>) shared-biology model across both pouch routes.</p>

      <div class="notes">
        <p><strong>What these numbers are.</strong> Our own computational estimates for each combined design, anchored to human trial data where partial proof exists (hurdles 1 and 2) and to 3D physics and sequence models where it does not yet (hurdles 3 and 4). Layering new untested edits together can shift earlier hurdles too, so none of these figures is a lab measurement or the chance of a cure.</p>
        <p><strong>Why three designs — and two pouch routes.</strong> Even the highest-scoring simulated design (Design X, about {xVal}%) faces real biological risk on its own, while Design A (about {aVal}%) keeps the simplest genetic build as a low-risk baseline control and Design B (about {bVal}%) covers an independent HLA-C and chemical-free pouch route. Advancing all three side by side across both pouch routes reaches <strong>about {sharedAxModularVal}% ({sharedAxModularExact}%, modular)</strong> if the winning cell line and pouch prove compatible in Stage 0, or <strong>about {sharedAxLockedVal}% ({sharedAxLockedExact}%, locked)</strong> for one fixed blueprint (common-shock ceiling {ceilingExact}%; legacy three-slot figure about {threeVal}% / {legacyThreeLockedExact}%; see warning 4 in the <a href="/downloads/ISLET-1-BLUEPRINT.md" download>full blueprint</a>).</p>
        <p><strong>Not the same as the model score.</strong> The 0 to 1 scores on the home page rank fixed-grid designs against each other. They are not percentages, and they are not these odds.</p>
        <p><strong>Updated as designs and results evolve.</strong> Up from about {oddsLaunchThree}% across three designs (and about {oddsLaunchSingle}% for one design alone) when the open draft opened on {longDate(draft.opens)}. We review these percentages when accepted blueprint changes, new human trial data or OpenIslet lab results change our assessment; all underlying hurdle numbers remain unchanged pre-wet-lab computational engineering judgements after IIP-0029, IIP-0030 and IIP-0031, with the headline now displaying the exact two-route modular figure (about {sharedAxModularVal}%). Hurdle estimates last changed {longDate(oddsLastUpdated)}; checked against the {longDate(latestBlueprintDate)} blueprint.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .odds {
    /* The next section (the gene edits) has its own top padding on the same background, so this end is left open. */
    padding-block: clamp(3rem, 6vw, 5rem) 0;
    scroll-margin-top: calc(var(--bar, 3.5rem) + 0.75rem);
  }
  .odds__lead {
    margin-top: 0.875rem;
    max-width: 48rem;
  }
  /* four columns on a wide screen, two on a medium one, one on a phone: never an uneven last row. The picture is the only panel. */
  .odds__cards {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem 1.75rem;
  }
  @media (min-width: 40em) {
    .odds__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 75em) {
    .odds__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .odd {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .odd__vis {
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--ink-2);
  }
  .odd__vis :global(svg) {
    display: block;
    width: 100%;
    max-height: 10.5rem;
    height: auto;
  }
  .odd__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem 0.75rem;
  }
  .odd__n {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }
  .odd__t {
    font-size: 1.1875rem;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .odd__est {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .odd__row,
  .odd__scen {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.125rem 0.75rem;
  }
  .odd__scen[hidden] {
    display: none;
  }
  .odd__lab {
    font-size: 0.9375rem;
    color: var(--body);
  }
  .odd__pct {
    font-size: 1.0625rem;
    font-weight: 500;
    text-align: right;
  }
  .odd__bar {
    grid-column: 1 / -1;
    height: 0.625rem;
  }
  .odd__bar--three > span {
    background: #6b7c88;
  }
  .odd__plain {
    font-size: 0.96875rem;
    color: var(--body);
  }
  .odd__ev {
    margin-top: 0.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-soft);
  }
  .odd__next {
    display: block;
    margin-top: 0.375rem;
    color: var(--body);
    font-weight: 600;
  }

  .odds__sum {
    margin-top: 2.5rem;
  }
  /* The two results are plain columns with a hairline between them, not boxes inside the panel. */
  .odds__results {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 48em) {
    .odds__results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .res + .res {
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }
  }
  @media (max-width: 47.99em) {
    .res + .res {
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
    }
  }
  .res__k {
    font-size: 1rem;
  }
  .res__k span {
    display: block;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .res__stack {
    list-style: none;
    padding: 0;
    margin: 0.875rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .res__item + .res__item {
    padding-top: 0.875rem;
    border-top: 1px solid var(--line-soft);
  }
  .res__itemhead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .res__name {
    font-size: 0.9375rem;
  }
  .res__name span {
    display: block;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .res__mid {
    font-size: clamp(1.375rem, 2.5vw, 1.6875rem);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
  }
  .res__big {
    margin-top: 0.75rem;
    font-size: clamp(2.25rem, 4.6vw, 3.125rem);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .res__about {
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
  }
  .res__mod {
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    white-space: nowrap;
  }
  .res__bar {
    display: block;
    margin-top: 0.5rem;
  }
  .res--three .res__bar {
    margin-top: 0.75rem;
  }
  .res__formula {
    margin-top: 0.4375rem;
    font-size: 0.875rem;
    color: var(--body);
    overflow-wrap: anywhere;
  }
  .res--three .res__formula {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
  }
  .res__why {
    margin-top: 0.875rem;
    font-size: 0.9375rem;
    color: var(--body);
  }
  .odds__scope {
    margin-top: 0.5rem;
    max-width: 48rem;
  }
  .odds__rule {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .notes {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.875rem 2rem;
  }
  @media (min-width: 48em) {
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .notes p {
    font-size: 0.96875rem;
    color: var(--body);
    text-wrap: pretty;
  }
  .notes strong {
    color: var(--ink);
  }

  /* printing the specification leaves the page's other sections out */
  @media print {
    .odds {
      display: none !important;
    }
  }
</style>
