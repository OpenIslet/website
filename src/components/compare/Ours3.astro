---
// Islet-1: protection that switches on with inflammation, and a safety switch. The darts are stopped.
import Cell from '../art/Cell.astro';
import Immune from '../art/Immune.astro';
---

<svg viewBox="0 0 360 150" role="img" aria-label="The same islet cell under inflammation, now with a shield inside and a back-off signal on its surface. The toxin darts are stopped. A solid switch on the right shows the cell carries a safety switch.">
  <g font-family="IBM Plex Sans, sans-serif">
    <g stroke="#f2a93b" stroke-width="3" fill="none" stroke-linecap="round" stroke-opacity="0.85">
      <path d="M26 24 q8 -9 16 0 t16 0 t16 0 t16 0"></path>
      <path d="M44 40 q8 -9 16 0 t16 0 t16 0"></path>
    </g>
    <Cell x={112} y={86} r={40} kind="beta" />
    <path d="M100 70 L116 76 V92 C116 104 108 110 100 114 C92 110 84 104 84 92 V76 Z" fill="#8ea0ff" stroke="#0b1b26" stroke-width="2.5" stroke-linejoin="round"></path>
    <path d="M92 92 l6 6 l11 -13" stroke="#0b1b26" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>

    <polygon points="146,50 156,46 166,50 170,60 166,70 156,74 146,70 142,60" fill="#0b1b26" stroke="#8ea0ff" stroke-width="2.5"></polygon>
    <path d="M149 60 h14" stroke="#8ea0ff" stroke-width="3.5" stroke-linecap="round"></path>

    <g fill="#f2a93b" stroke="#0b1b26" stroke-width="1.5" stroke-linejoin="round">
      <polygon points="182,90 198,84 198,96"></polygon>
      <polygon points="208,108 224,102 224,114"></polygon>
    </g>
    <path d="M168 94 l12 12 M180 94 l-12 12" stroke="#f2a93b" stroke-width="3.5" stroke-linecap="round"></path>
    <Immune x={282} y={78} r={26} kind="tcell" />

    <rect x="268" y="116" width="64" height="26" rx="13" fill="#5b73ff" stroke="#0b1b26" stroke-width="2.5"></rect>
    <circle cx="319" cy="129" r="9" fill="#e6edf2" stroke="#0b1b26" stroke-width="2"></circle>
  </g>
</svg>
