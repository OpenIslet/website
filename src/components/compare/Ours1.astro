---
// Islet-1: cells designed to be left alone by the immune system. The immune cells are fully active, and turn away.
import Cell from '../art/Cell.astro';
import Immune from '../art/Immune.astro';
---

<svg viewBox="0 0 360 150" role="img" aria-label="A cluster of islet cells inside a protective ring, carrying two don't-attack-me signals. Active immune cells approach and turn away. A crossed-out pill shows the aim: no drugs needed.">
  <circle cx="108" cy="78" r="64" fill="#8ea0ff" fill-opacity="0.08" stroke="#8ea0ff" stroke-width="2.5" stroke-dasharray="3 7"></circle>
  <Cell x={98} y={70} r={24} kind="beta" />
  <Cell x={132} y={92} r={20} kind="alpha" />
  <Cell x={84} y={102} r={16} kind="delta" />
  <Cell x={68} y={78} r={14} kind="beta" />

  <g stroke="#8ea0ff" stroke-width="2.5" fill="none">
    <path d="M166 52 L150 60"></path>
    <path d="M170 98 L152 92"></path>
  </g>
  <circle cx="170" cy="50" r="8" fill="#e6edf2" stroke="#0b1b26" stroke-width="2"></circle>
  <circle cx="174" cy="99" r="8" fill="#8ea0ff" stroke="#0b1b26" stroke-width="2"></circle>

  <Immune x={266} y={56} r={22} kind="tcell" />
  <path d="M242 54 C214 52, 202 44, 196 28" stroke="#f2a93b" stroke-width="2.5" stroke-dasharray="3 5" fill="none" stroke-linecap="round"></path>
  <path d="M188 38 L196 26 L206 34" stroke="#f2a93b" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>

  <Immune x={270} y={116} r={18} kind="nk" />
  <path d="M250 120 C226 124, 208 130, 198 142" stroke="#f2a93b" stroke-width="2.5" stroke-dasharray="3 5" fill="none" stroke-linecap="round"></path>
  <path d="M190 134 L198 144 L209 138" stroke="#f2a93b" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>

  <g transform="translate(326 38)">
    <circle r="22" fill="none" stroke="#f2a93b" stroke-width="3.5"></circle>
    <g transform="rotate(-28)">
      <rect x="-14" y="-6" width="28" height="12" rx="6" fill="#e6edf2" stroke="#0b1b26" stroke-width="2"></rect>
      <line x1="0" y1="-6" x2="0" y2="6" stroke="#0b1b26" stroke-width="2"></line>
    </g>
    <line x1="-16" y1="-16" x2="16" y2="16" stroke="#f2a93b" stroke-width="3.5" stroke-linecap="round"></line>
  </g>
</svg>
