---
// Today: one design for everyone. The same cells go to every patient, and some patients' immune systems still attack.
import Person from '../art/Person.astro';
import Cell from '../art/Cell.astro';
import Immune from '../art/Immune.astro';

const people = [
  { x: 44, fill: '#e6edf2', attacked: false },
  { x: 112, fill: '#c9d3ff', attacked: true },
  { x: 180, fill: '#a6b6c2', attacked: false },
  { x: 248, fill: '#8ea0ff', attacked: true },
  { x: 316, fill: '#e6edf2', attacked: false },
];
---

<svg viewBox="0 0 360 150" role="img" aria-label="Five different patients each receive the identical cells. Two of them still show an immune attack on the cells.">
  <g font-family="IBM Plex Sans, sans-serif">
    {people.map((p) => <Person x={p.x} y={30} fill={p.fill} />)}
    {people.map((p) => <Cell x={p.x} y={104} r={13} kind="beta" />)}
    {
      people.map((p) =>
        p.attacked ? (
          <g>
            <Immune x={p.x + 22} y={90} r={8} kind="tcell" />
            <path d={`M${p.x + 15} ${94} L${p.x + 9} ${98}`} stroke="#f2a93b" stroke-width="2.5" stroke-linecap="round"></path>
            <text x={p.x} y="140" font-size="20" font-weight="700" fill="#f2a93b" text-anchor="middle">!</text>
          </g>
        ) : (
          <path d={`M${p.x - 7} 134 l5 5 l10 -11`} stroke="#8ea0ff" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
        ),
      )
    }
  </g>
</svg>
