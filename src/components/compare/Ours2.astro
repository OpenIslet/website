---
// Islet-1: built-in oxygen and blood supply. Small clusters, vessel fragments and an oxygen-releasing layer.
import Cell from '../art/Cell.astro';

const x = [66, 114, 162, 210, 258, 306];
const v = [90, 138, 186, 234, 282];
---

<svg viewBox="0 0 360 150" role="img" aria-label="A thin slab of small islet cell clusters with pre-built blood-vessel fragments and a central layer that releases oxygen. Oxygen bubbles drift out to the cells.">
  <defs>
    <pattern id="o2-hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="9" stroke="#8ea0ff" stroke-width="2.5" stroke-opacity="0.7"></line>
    </pattern>
  </defs>
  <rect x="24" y="20" width="312" height="110" rx="14" fill="#0b1b26" fill-opacity="0.35" stroke="#8ea0ff" stroke-opacity="0.6" stroke-width="2"></rect>
  <rect x="34" y="64" width="292" height="22" rx="4" fill="url(#o2-hatch)" stroke="#8ea0ff" stroke-width="1.5"></rect>
  {x.map((cx, i) => <Cell x={cx} y={42} r={15} kind={i % 3 === 1 ? 'alpha' : 'beta'} />)}
  {x.map((cx, i) => <Cell x={cx} y={108} r={15} kind={i % 3 === 0 ? 'alpha' : 'beta'} />)}
  {
    v.map((cx) => (
      <g>
        <circle cx={cx} cy="42" r="6" fill="#0b1b26" stroke="#e6edf2" stroke-width="2.2"></circle>
        <circle cx={cx} cy="108" r="6" fill="#0b1b26" stroke="#e6edf2" stroke-width="2.2"></circle>
      </g>
    ))
  }
  <g fill="none" stroke="#e6edf2" stroke-width="1.8">
    <circle cx="76" cy="58" r="3.5"></circle>
    <circle cx="150" cy="56" r="3.5"></circle>
    <circle cx="224" cy="58" r="3.5"></circle>
    <circle cx="296" cy="56" r="3.5"></circle>
    <circle cx="100" cy="94" r="3.5"></circle>
    <circle cx="176" cy="96" r="3.5"></circle>
    <circle cx="250" cy="94" r="3.5"></circle>
  </g>
</svg>
