---
// Test 5: oxygen for the first 3 days, and a safety switch. Numbered pins match the legend under the picture.
import Cell from '../art/Cell.astro';

const top = [70, 122, 174, 226, 278];
const vessels = [96, 148, 200, 252];
const bubbles = [
  [86, 162], [128, 150], [204, 160], [262, 152], [112, 208], [172, 214], [240, 206], [296, 212],
];
---

<svg viewBox="0 0 520 380" role="img" aria-label="Left: a thin layer of islet cell clusters with pre-built blood-vessel fragments and a central layer that releases oxygen. Right: a safety switch is on; a drug called AP1903 reaches the switch and the cells are removed.">
  <defs>
    <pattern id="t5-hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="9" stroke="#8ea0ff" stroke-width="2.5" stroke-opacity="0.7"></line>
    </pattern>
    <marker id="t5-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M1 1 L9 5 L1 9 z" fill="#e6edf2"></path>
    </marker>
  </defs>
  <g font-family="IBM Plex Sans, sans-serif">
    <text x="24" y="40" fill="#e6edf2" font-size="18" font-weight="600">First 3 days</text>

    <rect x="28" y="84" width="296" height="204" rx="14" fill="#0b1b26" fill-opacity="0.4" stroke="#8ea0ff" stroke-opacity="0.6" stroke-width="2"></rect>
    <rect x="40" y="172" width="272" height="26" rx="4" fill="url(#t5-hatch)" stroke="#8ea0ff" stroke-width="1.5"></rect>

    {top.map((x, i) => <Cell x={x} y={134} r={19} kind={i % 3 === 1 ? 'alpha' : 'beta'} />)}
    {top.map((x, i) => <Cell x={x} y={238} r={19} kind={i % 3 === 0 ? 'alpha' : 'beta'} />)}
    {
      vessels.map((x) => (
        <g>
          <circle cx={x} cy="134" r="9" fill="#0b1b26" stroke="#e6edf2" stroke-width="2.5"></circle>
          <circle cx={x} cy="238" r="9" fill="#0b1b26" stroke="#e6edf2" stroke-width="2.5"></circle>
        </g>
      ))
    }
    <g fill="none" stroke="#e6edf2" stroke-width="2" stroke-opacity="0.9">
      {bubbles.map(([x, y]) => <circle cx={x} cy={y} r="4.5"></circle>)}
    </g>

    <g font-size="15" font-weight="700" text-anchor="middle">
      <circle cx="70" cy="106" r="12" fill="#ffffff"></circle><text x="70" y="111" fill="#0b1b26">1</text>
      <circle cx="148" cy="106" r="12" fill="#ffffff"></circle><text x="148" y="111" fill="#0b1b26">2</text>
      <path d="M312 185 H340" stroke="#ffffff" stroke-width="2" fill="none"></path>
      <circle cx="352" cy="185" r="12" fill="#ffffff"></circle><text x="352" y="190" fill="#0b1b26">3</text>
    </g>

    <!-- safety switch -->
    <text x="428" y="104" fill="#e6edf2" font-size="17" font-weight="600" text-anchor="middle">Safety switch</text>
    <rect x="384" y="118" width="88" height="42" rx="21" fill="#4258ee" stroke="#0b1b26" stroke-width="2.5"></rect>
    <circle cx="451" cy="139" r="15" fill="#e6edf2" stroke="#0b1b26" stroke-width="2"></circle>
    <text x="408" y="145" fill="#ffffff" font-size="15" font-weight="700" text-anchor="middle">ON</text>

    <path d="M416 182 h24 v12 l10 10 v34 q0 8 -8 8 h-28 q-8 0 -8 -8 v-34 l10 -10 z" fill="#e6edf2" fill-opacity="0.92" stroke="#0b1b26" stroke-width="2"></path>
    <path d="M404 226 h48" stroke="#5b73ff" stroke-width="3"></path>
    <text x="428" y="272" fill="#e6edf2" font-size="16" font-weight="600" text-anchor="middle">AP1903</text>

    <path d="M428 282 V306" stroke="#e6edf2" stroke-width="2.5" fill="none" marker-end="url(#t5-arrow)"></path>
    <Cell x={398} y={330} r={13} kind="beta" ghost />
    <Cell x={428} y={336} r={15} kind="alpha" ghost />
    <Cell x={458} y={330} r={13} kind="beta" ghost />
    <text x="428" y="370" fill="#a6b6c2" font-size="15" text-anchor="middle">cells removed</text>
  </g>
</svg>
