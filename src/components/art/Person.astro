---
// A simple person, for pictures about patients.
interface Props {
  x: number;
  y: number;
  fill?: string;
}
const { x, y, fill = '#e6edf2' } = Astro.props;
---

<g>
  <circle cx={x} cy={y} r="10" fill={fill} stroke="#0b1b26" stroke-width="2.5"></circle>
  <path d={`M${x - 17} ${y + 36} v-8 a17 17 0 0 1 34 0 v8 z`} fill={fill} stroke="#0b1b26" stroke-width="2.5" stroke-linejoin="round"></path>
</g>
