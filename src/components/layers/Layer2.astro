---
// Schematic only: four candidate edit sites and decorative bars, not predictions or measurements.
const strand = (sign: number) =>
  Array.from({ length: 56 }, (_, i) => {
    const x = 14 + i * 4.5;
    return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${(66 + sign * 20 * Math.sin((i / 56) * Math.PI * 4)).toFixed(1)}`;
  }).join(' ');
const rungs = Array.from({ length: 26 }, (_, i) => {
  const x = 18 + i * 10;
  const s = 20 * Math.sin(((x - 14) / 252) * Math.PI * 4);
  return { x, y1: 66 + s, y2: 66 - s };
});
const sites = [52, 112, 172, 232];

let seed = 9;
const next = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
const bars = Array.from({ length: 62 }, (_, i) => ({ x: 14 + i * 4.3, h: 4 + next() * 18 }));
const tall = new Set([9, 23, 37, 50]);
---

<svg viewBox="0 0 280 176" role="img" aria-label="Schematic DNA with four candidate edit sites and decorative bars. The bars do not represent model predictions, scans or measured variant effects.">
  <g stroke="#8ea0ff" stroke-opacity="0.35" stroke-width="2">
    {rungs.map((r) => <line x1={r.x} y1={r.y1} x2={r.x} y2={r.y2}></line>)}
  </g>
  <path d={strand(1)} fill="none" stroke="#8ea0ff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <path d={strand(-1)} fill="none" stroke="#e6edf2" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
  {
    sites.map((x) => (
      <g>
        <line x1={x} y1="26" x2={x} y2="46" stroke="#f2a93b" stroke-width="2.5" stroke-dasharray="2 3"></line>
        <circle cx={x} cy="20" r="8" fill="#5b73ff" stroke="#0b1b26" stroke-width="2.5"></circle>
      </g>
    ))
  }

  <line x1="14" y1="162" x2="266" y2="162" stroke="#a6b6c2" stroke-opacity="0.5" stroke-width="1.5"></line>
  {
    bars.map((b, i) => (
      <rect x={b.x} y={162 - (tall.has(i) ? 38 + (i % 3) * 3 : b.h)} width="2.6" height={tall.has(i) ? 38 + (i % 3) * 3 : b.h} rx="1.3" fill={tall.has(i) ? '#f2a93b' : '#8ea0ff'} fill-opacity={tall.has(i) ? 1 : 0.7}></rect>
    ))
  }
</svg>
