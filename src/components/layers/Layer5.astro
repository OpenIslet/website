---
// Layer 5: the patient. A patient's DNA goes into a compiler, which picks a plan. Below, a crowd of virtual patients across five ancestries.
const groups = ['#5b73ff', '#8ea0ff', '#e6edf2', '#a6b6c2', '#c9d3ff'];
const rows = groups.map((c, r) => ({ c, y: 112 + r * 11 }));
const cols = Array.from({ length: 21 }, (_, i) => 16 + i * 12.2);
---

<svg viewBox="0 0 280 176" role="img" aria-label="A patient's DNA goes into a compiler that picks the plan that fits, Plan A or Plan B. Below, rows of dots stand for 10,000 virtual patients from five ancestries.">
  <path d="M16 38 C26 22, 36 22, 46 38 S66 54, 76 38" fill="none" stroke="#8ea0ff" stroke-width="3.5" stroke-linecap="round"></path>
  <path d="M16 38 C26 54, 36 54, 46 38 S66 22, 76 38" fill="none" stroke="#e6edf2" stroke-width="3.5" stroke-linecap="round"></path>

  <path d="M86 38 H100" stroke="#8ea0ff" stroke-width="3" stroke-linecap="round" fill="none"></path>
  <path d="M96 32 l8 6 l-8 6" stroke="#8ea0ff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>

  <rect x="110" y="16" width="58" height="44" rx="8" fill="#13293a" stroke="#8ea0ff" stroke-width="2"></rect>
  <g stroke="#e6edf2" stroke-width="3.5" stroke-linecap="round">
    <path d="M122 30 H156"></path>
    <path d="M122 40 H148"></path>
    <path d="M122 50 H152" stroke="#5b73ff"></path>
  </g>

  <path d="M174 38 H188" stroke="#8ea0ff" stroke-width="3" stroke-linecap="round" fill="none"></path>
  <path d="M184 32 l8 6 l-8 6" stroke="#8ea0ff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>

  <g font-family="IBM Plex Sans, sans-serif" font-size="12" font-weight="700" text-anchor="middle">
    <rect x="198" y="16" width="64" height="20" rx="10" fill="#4258ee"></rect>
    <text x="230" y="30" fill="#ffffff">Plan A</text>
    <rect x="198" y="42" width="64" height="20" rx="10" fill="#e6edf2"></rect>
    <text x="230" y="56" fill="#0b1b26">Plan B</text>
  </g>

  {
    rows.map((row) =>
      cols.map((x) => <circle cx={x} cy={row.y} r="3.6" fill={row.c} fill-opacity="0.9"></circle>),
    )
  }
</svg>
