---
// The six stage rows of the timeline explorer, as a list of rows that fold open. Each row sets what could be
// prepared ahead beside the checks that keep their full length. Every word comes from src/data/future.ts.
import EvidenceChip from './EvidenceChip.astro';
import SciDrawer from './SciDrawer.astro';

interface Stage {
  step: number;
  id: string;
  title: string;
  scopeBadge: string;
  evidenceClass: 'Computed' | 'Literature' | 'Assumption' | 'Idea';
  preparedAhead: string;
  safetyFloor: string;
  stopRule: string;
  science: readonly string[];
  parallelCaption?: string;
}
interface Props {
  stages: readonly Stage[];
  labels: { prepared: string; floor: string; stop: string; scientists: string };
}
const { stages, labels } = Astro.props;
---

<ol class="rows">
  {
    stages.map((s) => (
      <li>
        <details class="row" id={s.id}>
          <summary class="row__sum">
            <span class="row__n">{s.step}</span>
            <span class="row__head">
              <span class="row__title">{s.title}</span>
              <span class="row__meta">
                <EvidenceChip kind={s.evidenceClass} />
              </span>
            </span>
            <span class="row__chev" aria-hidden="true" />
          </summary>
          <div class="row__body">
            {s.scopeBadge && <p class="row__scope pretty">{s.scopeBadge}</p>}
            <div class="pair">
              <section class="pane pane--prep">
                <h4 class="pane__k">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h14M12.5 6.5 18 12l-5.5 5.5"></path></svg>
                  {labels.prepared}
                </h4>
                <p class="pretty">{s.preparedAhead}</p>
              </section>
              <section class="pane pane--floor">
                <h4 class="pane__k">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="9.5" rx="2"></rect><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"></path></svg>
                  {labels.floor}
                </h4>
                <p class="pretty">{s.safetyFloor}</p>
              </section>
            </div>
            {s.parallelCaption && <p class="row__note pretty">{s.parallelCaption}</p>}
            <p class="stop">
              <span class="stop__k">{labels.stop}</span>
              <span class="pretty">{s.stopRule}</span>
            </p>
            <SciDrawer label={labels.scientists} paragraphs={s.science} />
          </div>
        </details>
      </li>
    ))
  }
</ol>

<style>
  .rows {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .row {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    scroll-margin-top: 1rem;
  }
  .row[open] {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }
  .row__sum {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 4rem;
    padding: 0.75rem clamp(0.875rem, 2vw, 1.25rem);
    cursor: pointer;
    list-style: none;
    border-radius: 0.75rem;
  }
  .row__sum::-webkit-details-marker {
    display: none;
  }
  .row__sum:hover .row__title {
    color: var(--accent-dk);
  }
  .row__n {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
  }
  .row__head {
    flex: 1 1 auto;
    min-width: 0;
    display: grid;
    gap: 0.25rem;
  }
  .row__title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }
  .row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
  }
  .row__scope {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .row__chev {
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    margin: 0 0.375rem 0.25rem;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }
  .row[open] .row__chev {
    transform: rotate(-135deg);
    margin-bottom: -0.25rem;
  }
  .row__body {
    display: grid;
    gap: 0.75rem;
    padding: 0 clamp(0.875rem, 2vw, 1.25rem) 0.25rem;
  }
  .pair {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 52em) {
    .pair {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .pane {
    padding: 1rem 1.125rem;
    border-radius: 0.5rem;
    background: var(--tint);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .pane--floor {
    background: var(--pass-bg);
  }
  .pane__k {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0 0 0.375rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent-dk);
  }
  .pane--floor .pane__k {
    color: var(--pass);
  }
  .row__note {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .stop {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: var(--warn-bg);
    color: var(--ink);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .stop__k {
    flex: none;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--warn);
  }
  @media (prefers-reduced-motion: reduce) {
    .row__chev {
      transition: none;
    }
  }
</style>
