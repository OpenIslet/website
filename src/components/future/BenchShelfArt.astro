---
// The picture at the top of /future: what is on the bench today above, what is kept on the shelf below, and the gate
// between them. The share-card tool copies this <svg> by its id into the page's share picture, so everything it needs
// is written on the elements themselves (no page styles), and none of its labels may hold a digit.
// The labels come from `pageCopy.benchShelf` in src/data/future.ts.
interface Props {
  copy: {
    svgTitle: string;
    benchHeading: string;
    blueprintLabel: string;
    shieldTitle: string;
    shieldSub: string;
    quarantineLabel: string;
    shelfHeading: string;
    shelfItems: readonly string[];
  };
}
const { copy } = Astro.props;
const font = "'IBM Plex Sans', system-ui, sans-serif";
const tiles = [36, 176, 316];
---

<svg id="bench-shelf-svg" viewBox="0 0 480 404" role="img" aria-labelledby="bench-shelf-svg-title" xmlns="http://www.w3.org/2000/svg">
  <title id="bench-shelf-svg-title">{copy.svgTitle}</title>
  <rect width="480" height="404" rx="22" fill="#0b1b26"></rect>

  {/* On the bench today: a solid panel, the blueprint sheets and the full safety checks. */}
  <rect x="16" y="16" width="448" height="170" rx="14" fill="#13293a" stroke="#8ea0ff" stroke-opacity="0.55" stroke-width="1.5"></rect>
  <text x="36" y="46" font-family={font} font-size="15" font-weight="600" letter-spacing="1.2" fill="#8ea0ff">{copy.benchHeading}</text>

  <g>
    <rect x="52" y="64" width="164" height="92" rx="8" fill="#1b2ba3"></rect>
    <rect x="44" y="72" width="164" height="92" rx="8" fill="#2a3fd6" stroke="#8ea0ff" stroke-width="1.5"></rect>
    <path d="M58 90h72M58 104h110M58 118h54" stroke="#c9d3ff" stroke-width="3" stroke-linecap="round" fill="none"></path>
    <circle cx="176" cy="96" r="12" fill="none" stroke="#c9d3ff" stroke-width="2.5"></circle>
    <circle cx="176" cy="96" r="4" fill="#c9d3ff"></circle>
    <text x="126" y="148" text-anchor="middle" font-family={font} font-size="18" font-weight="600" fill="#ffffff">{copy.blueprintLabel}</text>
  </g>

  <g>
    <rect x="236" y="64" width="212" height="100" rx="12" fill="#0b6b45" fill-opacity="0.32" stroke="#4fc79a" stroke-width="1.5"></rect>
    <path d="M268 86l20 7v15c0 13-8.5 22-20 27-11.500-5-20-14-20-27V93z" fill="#0b6b45" stroke="#7fe0b9" stroke-width="2.5" stroke-linejoin="round"></path>
    <rect x="259" y="107" width="18" height="14" rx="3" fill="#7fe0b9"></rect>
    <path d="M262.500 107v-4.500a5.500 5.500 0 0 1 11 0v4.500" fill="none" stroke="#7fe0b9" stroke-width="2.500" stroke-linecap="round"></path>
    <text x="300" y="108" font-family={font} font-size="17" font-weight="600" fill="#ffffff">{copy.shieldTitle}</text>
    <text x="300" y="131" font-family={font} font-size="15" fill="#b9ecd6">{copy.shieldSub}</text>
  </g>

  {/* The gate: nothing crosses it without proof from the lab. */}
  <path d="M16 202h448" stroke="#f2a93b" stroke-width="2" stroke-dasharray="6 6" fill="none"></path>
  <rect x="84" y="186" width="312" height="32" rx="16" fill="#0b1b26" stroke="#f2a93b" stroke-width="1.5"></rect>
  <rect x="100" y="198" width="12" height="10" rx="2" fill="#f2a93b"></rect>
  <path d="M102.500 198v-3a3.500 3.500 0 0 1 7 0v3" fill="none" stroke="#f2a93b" stroke-width="2" stroke-linecap="round"></path>
  <text x="250" y="207" text-anchor="middle" font-family={font} font-size="14.500" font-weight="600" fill="#f2a93b">{copy.quarantineLabel}</text>

  {/* Prepared on the shelf: a dashed panel and three unbuilt things. */}
  <rect x="16" y="218" width="448" height="170" rx="14" fill="none" stroke="#8ea0ff" stroke-opacity="0.55" stroke-width="1.5" stroke-dasharray="6 5"></rect>
  <text x="36" y="250" font-family={font} font-size="15" font-weight="600" letter-spacing="1.2" fill="#8ea0ff">{copy.shelfHeading}</text>
  {
    tiles.map((x, i) => (
      <g>
        <rect x={x} y="264" width="128" height="108" rx="10" fill="#ffffff" fill-opacity="0.05" stroke="#ffffff" stroke-opacity="0.3" stroke-width="1.5" stroke-dasharray="5 4"></rect>
        {i === 0 && (
          <g fill="none" stroke="#8ea0ff" stroke-width="3">
            <circle cx={x + 52} cy="306" r="15"></circle>
            <circle cx={x + 76} cy="306" r="15"></circle>
          </g>
        )}
        {i === 1 && (
          <g fill="none" stroke="#f2a93b" stroke-width="3.500" stroke-linecap="round">
            <path d={`M${x + 50} 292l28 28M${x + 78} 292l-28 28`}></path>
          </g>
        )}
        {i === 2 && (
          <g>
            <path d={`M${x + 54} 304v-6a10 10 0 0 1 20 0v6`} fill="none" stroke="#c5d1da" stroke-width="3.500" stroke-linecap="round"></path>
            <rect x={x + 47} y="302" width="34" height="24" rx="5" fill="#f2a93b"></rect>
            <circle cx={x + 64} cy="314" r="3.500" fill="#0b1b26"></circle>
          </g>
        )}
        <text x={x + 64} y="356" text-anchor="middle" font-family={font} font-size="14.500" font-weight="600" fill="#e6edf2">{copy.shelfItems[i]}</text>
      </g>
    ))
  }
</svg>
