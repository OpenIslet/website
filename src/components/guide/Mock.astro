---
// A simplified picture of a screen, so people know where to click. It is decoration only: the steps beside it say everything.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="mock" aria-hidden="true">
  <div class="mock__bar"><i></i><i></i><i></i><span>{title}</span></div>
  <div class="mock__body"><slot /></div>
</div>

<style>
  .mock {
    border: 1px solid var(--line-strong);
    border-radius: 0.75rem;
    background: #fff;
    overflow: hidden;
    box-shadow: var(--shadow);
    font-size: 0.8125rem;
    color: var(--body);
    pointer-events: none;
    user-select: none;
  }
  .mock__bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .mock__bar i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .mock__bar span {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }
  .mock__body {
    padding: 0.875rem;
  }
</style>
