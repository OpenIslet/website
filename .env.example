# Copy to .env to change what the site shows.

# Show the model scores for Design A, Design B and the reference designs. Defaults to true.
# PUBLIC_SHOW_SCENARIO_INDICES=false

# Show clearly labelled example rows on the Contributions board, so the layout is visible. Defaults to false.
# PUBLIC_SHOW_SAMPLE_LEADERBOARDS=true

# The home page hero background: "photo" (an islet micrograph) or "cells" (the drawn field of cells). Defaults to photo.
# PUBLIC_HERO_BACKGROUND=cells

# Whether the OpenIslet connector is open to the public: "planned" or "live". Defaults to planned.
# While it is "planned", the Start here guide tells visitors the steps are a preview.
# PUBLIC_CONNECTOR_STATUS=live

# Whether sending an IIP is open. The connector can be live for reading while the public queue is still closed.
# Set to true when the public queue opens. Defaults to false.
# PUBLIC_SUBMISSIONS_OPEN=true

# Where the web submission form (/submit) sends IIPs: the connector's address. Defaults to https://mcp.openislet.org.
# When testing with a local Worker (npm --prefix connector run dev), use http://127.0.0.1:8787.
# PUBLIC_QUEUE_API=http://127.0.0.1:8787

# Whether search engines may list the site. Off until the site is public: pages say "noindex" and robots.txt turns crawlers away.
# Set to true when the site goes live. Defaults to false.
# PUBLIC_INDEXABLE=true
